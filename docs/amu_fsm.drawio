<mxfile host="app.diagrams.net" agent="amu-fsm-generator" version="24.7.5"><diagram id="amu_fsm" name="AMU FSM"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2336" pageHeight="2255" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="search_phase" value="SEARCH (phase)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="790" height="190" as="geometry"/></mxCell><mxCell id="storage" value="STORAGE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="946" height="1095" as="geometry"/></mxCell><mxCell id="pathfind" value="PATHFIND" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="1026" y="620" width="1270" height="1095" as="geometry"/></mxCell><mxCell id="dist_group" value="DISTANCE ADJUST" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=24;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#e4e4e4;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#efefef;" vertex="1" parent="storage"><mxGeometry x="70" y="48" width="810" height="340" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;AMU parcel-run FSM&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=20;fontFamily=Helvetica;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="One box per State in the Src/main.c switch (the ST_* enum). UML state-machine notation: trigger [guard] / effect. Terms follow GLOSSARY.md. A / B is the Layout learned by IDENTIFY." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="2200" height="18" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="182" y="124" width="16" height="16" as="geometry"/></mxCell><mxCell id="idle" value="IDLE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="300" height="140" as="geometry"/></mxCell><mxCell id="search" value="SEARCH" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="search_phase"><mxGeometry x="30" y="70" width="260" height="80" as="geometry"/></mxCell><mxCell id="identify" value="IDENTIFY" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="search_phase"><mxGeometry x="460" y="50" width="300" height="120" as="geometry"/></mxCell><mxCell id="d_app" value="DEPOSIT_APPROACH" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="dist_group"><mxGeometry x="480" y="64" width="310" height="80" as="geometry"/></mxCell><mxCell id="d_dist" value="DEPOSIT_DISTANCE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="dist_group"><mxGeometry x="20" y="194" width="310" height="122" as="geometry"/></mxCell><mxCell id="d_rev" value="DEPOSIT_REVERSE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="dist_group"><mxGeometry x="480" y="215" width="310" height="80" as="geometry"/></mxCell><mxCell id="d_align" value="DEPOSIT_ALIGN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="90" y="468" width="310" height="108" as="geometry"/></mxCell><mxCell id="d_rturn" value="DEPOSIT_REFINE_TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="550" y="475" width="310" height="94" as="geometry"/></mxCell><mxCell id="deposit" value="DEPOSIT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="90" y="673" width="310" height="108" as="geometry"/></mxCell><mxCell id="d_rsample" value="DEPOSIT_REFINE_SAMPLE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="550" y="666" width="310" height="122" as="geometry"/></mxCell><mxCell id="drive_in" value="DRIVE_IN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="90" y="885" width="310" height="94" as="geometry"/></mxCell><mxCell id="turn" value="TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="550" y="885" width="310" height="94" as="geometry"/></mxCell><mxCell id="storage_note" value="TURN ignores bumper and cliff (the turn is made beside the ledge). DRIVE_IN ignores the cliff; any bumper ends it in DEPOSIT. Every State here faults on B1 | wheeldrop; the three DISTANCE ADJUST States also fault on any bumper or cliff, or on a zero or maximum-range reading." style="shape=note;size=10;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#808080;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=10.5;fontFamily=Helvetica;fontColor=#444444;" vertex="1" parent="storage"><mxGeometry x="30" y="1015" width="886" height="58" as="geometry"/></mxCell><mxCell id="p_drive" value="DRIVE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="800" y="80" width="320" height="80" as="geometry"/></mxCell><mxCell id="p_choice" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1472" y="706" width="28" height="28" as="geometry"/></mxCell><mxCell id="p_creverse" value="CORRIDOR_REVERSE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="300" y="270" width="320" height="94" as="geometry"/></mxCell><mxCell id="p_cturn" value="CORRIDOR_TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="300" y="490" width="320" height="124" as="geometry"/></mxCell><mxCell id="p_cstop" value="CORRIDOR_STOP" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="30" y="905" width="230" height="54" as="geometry"/></mxCell><mxCell id="p_reverse" value="REVERSE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="800" y="340" width="320" height="94" as="geometry"/></mxCell><mxCell id="p_rotate" value="ROTATE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="800" y="580" width="320" height="124" as="geometry"/></mxCell><mxCell id="pathfind_note" value="Runs twice: corridor = 1 ends in CORRIDOR_REVERSE, then CORRIDOR_TURN; corridor = 2 ends in CORRIDOR_STOP. A corridor ends on the front cliff, not on distance. DRIVE ignores the ledge-side bumper and the storage-wall-side cliff; REVERSE, ROTATE and the CORRIDOR_ States ignore bumper and cliff. Only B1 | wheeldrop faults here." style="shape=note;size=10;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#808080;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=10.5;fontFamily=Helvetica;fontColor=#444444;" vertex="1" parent="pathfind"><mxGeometry x="300" y="1015" width="820" height="58" as="geometry"/></mxCell><mxCell id="orient" value="ORIENT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1836" y="190" width="300" height="120" as="geometry"/></mxCell><mxCell id="fault" value="STOP / FAULT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;swimlaneFillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="520" y="440" width="1426" height="54" as="geometry"/></mxCell><mxCell id="lg_dot" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="44" y="1771" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_dot_t" value="start (initial State)" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="1771" width="150" height="18" as="geometry"/></mxCell><mxCell id="lg_dia" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="230" y="1765" width="28" height="28" as="geometry"/></mxCell><mxCell id="lg_dia_t" value="choice: one trigger, the guard on each edge picks the way" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="266" y="1771" width="350" height="18" as="geometry"/></mxCell><mxCell id="lg_st" value="state" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="1764" width="90" height="30" as="geometry"/></mxCell><mxCell id="lg_fa" value="fault" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;fontSize=11;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="770" y="1764" width="90" height="30" as="geometry"/></mxCell><mxCell id="lg_su" value="composite (phase)" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;fontSize=11;fontFamily=Helvetica;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="1764" width="170" height="30" as="geometry"/></mxCell><mxCell id="lg_red" value="&lt;font color=&quot;#b85450&quot;&gt;red edge&lt;/font&gt; = fault: the State (or every State in the region) leaves for STOP / FAULT" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1090" y="1771" width="800" height="18" as="geometry"/></mxCell><mxCell id="note_col1" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;A State is a rounded box: its name, then its actions. &lt;b&gt;entry /&lt;/b&gt; runs once on entering, &lt;b&gt;do /&lt;/b&gt; on every Tick in which no edge fired, &lt;b&gt;exit /&lt;/b&gt; once on leaving. Edges read: trigger [guard] / effect. A State&#x27;s edges are checked in priority order, the red fault edge first, and the first true one fires; a transition runs exit(), then the effect, then entry() of the next State. 1:, 2:, 3: number the edges that share a source.&lt;br&gt;&lt;br&gt;&lt;b&gt;ε&lt;/b&gt; = no trigger: the edge is taken on the next Tick. One Tick = one Kobuki packet: Kobuki_Read() runs first, then the state switch.&lt;br&gt;&lt;br&gt;Angles are degrees: + = ACW (left), - = CW (right). Gyro ticks are 0.01 degree. &lt;b&gt;heading&lt;/b&gt; = kobuki.angle, latched when ORIENT completes and when CORRIDOR_TURN is left.&lt;br&gt;&lt;br&gt;Setpoints (Kobuki_Rotate_Angle_Setpoint, Kobuki_Drive_Distance_Setpoint) are one-shot entry actions. kobuki.rotation_complete and kobuki.distance_complete are copied at the top of the Tick by Kobuki_Read(), so a State sees them one Tick after its last do / call.&lt;br&gt;&lt;br&gt;&lt;b&gt;Build option&lt;/b&gt;&lt;br&gt;DEPOSIT_TEST_MODE is a build-time constant (default 0), so only one of the two B0 edges out of IDLE exists in a given build. With it set to 1, the AMU also enters DEPOSIT once after the first Kobuki packet at boot, for bench-testing Deposit on its own." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1835" width="420" height="380" as="geometry"/></mxCell><mxCell id="note_col2" value="&lt;b&gt;Layouts&lt;/b&gt;&lt;br&gt;A / B is the Layout saved by IDENTIFY, never a live reading. Layout A: bollards A1/A2 block the left/top route; ORIENT turns clockwise to the bottom corridor; the storage wall is on the AMU&#x27;s left and the ledge on its right. Layout B is the mirror image: bollards B1/B2 block the bottom/right route; ORIENT turns anticlockwise to the left corridor.&lt;br&gt;&lt;br&gt;&lt;b&gt;Sensors&lt;/b&gt;&lt;br&gt;Bumper / cliff bits: right = 0x01, centre = 0x02, left = 0x04. B0 = kobuki.button &amp;amp; 0x01 (start). B1 = kobuki.button &amp;amp; 0x02 (stop). Fault_B1_Wheeldrop() = B1 | kobuki.wheeldrop != 0. Fault_Any() = that | any bumper | any cliff.&lt;br&gt;&lt;br&gt;&lt;b&gt;Faults&lt;/b&gt;&lt;br&gt;B1 | wheeldrop leaves every State except IDLE and STOP / FAULT. SEARCH, IDENTIFY, ORIENT and the three DISTANCE ADJUST States also fault on any bumper or cliff. Bumpers and cliffs are expected in PATHFIND and in the rest of STORAGE, so those regions have one red edge each, for B1 | wheeldrop only. Three faults are State-specific: the SEARCH give-up (a full turn without a bollard), a refine sweep with no echo, and a zero or maximum-range reading while adjusting the distance. STOP / FAULT stops the motors and returns to IDLE on the next Tick." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="490" y="1835" width="420" height="380" as="geometry"/></mxCell><mxCell id="note_col3" value="&lt;b&gt;Search phase&lt;/b&gt;&lt;br&gt;SEARCH turns anticlockwise on the spot from B0 and reads the ultrasonic once per Tick. &lt;b&gt;scan_deg&lt;/b&gt; is the net turn since B0 in degrees, ACW positive, summed from gyro changes so it does not wrap at 180; it only drives the give-up (scan_deg &gt;= 360: LED1 green, then FAULT). A Detection is range_mm &amp;lt; 750. IDENTIFY stops on the first Detection, then layout = Layout_From_Range(range_mm): B when range_mm &amp;lt; 575, otherwise A. LED1 red for A, yellow for B. There is no centring: ORIENT turns from wherever SEARCH stopped.&lt;br&gt;&lt;br&gt;&lt;b&gt;IDLE reset&lt;/b&gt;&lt;br&gt;Leaving IDLE (B0) clears layout, object.detected, heading and corridor, and zeroes the scan with Scan_Start(). DEPOSIT restarts the same scan counter for its own full circle.&lt;br&gt;&lt;br&gt;&lt;b&gt;Calibration (layout split, detect range)&lt;/b&gt;&lt;br&gt;The split is a calibration value (575 mm now). IDENTIFY reads the first in-range reading, taken as the sonar beam first reaches the bollard, so calibrate the same way: turn the AMU anticlockwise onto B1, then onto A1, and read robot.object.range_mm when SEARCH stops; the split goes between them. The detect range must stay above the A1 reading and below the nearest wall." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="940" y="1835" width="420" height="380" as="geometry"/></mxCell><mxCell id="note_col4" value="&lt;b&gt;Deposit&lt;/b&gt;&lt;br&gt;DEPOSIT turns anticlockwise through a full circle (scan_deg &gt;= 360) at 50 mm/s and keeps the closest valid echo (not 0, below 5000 mm) with its gyro heading. With no echo it lights LED1 red and returns to IDLE.&lt;br&gt;&lt;br&gt;DEPOSIT_ALIGN turns the short way to the saved heading. The first time, within 100 ticks, it starts the refine sweep; once the heading is refined, within 50 ticks, it goes to DEPOSIT_DISTANCE.&lt;br&gt;&lt;br&gt;The sweep visits 26 headings from -25 to +25 deg around the coarse heading, 2 deg apart. DEPOSIT_REFINE_TURN turns to a step at 35 mm/s; DEPOSIT_REFINE_SAMPLE stops, waits 15 Ticks, takes 3 readings 5 Ticks apart and keeps the median. After the last step, the centre of the widest run of steps within 10 mm of the closest median becomes the heading (ties: nearest the coarse heading). No valid median faults with LED1 red.&lt;br&gt;&lt;br&gt;DEPOSIT_DISTANCE holds still for 15 Ticks (about 300 ms) so the 10 Hz sonar catches up, then reads deposit_range_mm against the target 410 mm +/- 10 mm: too close backs off in DEPOSIT_REVERSE until 510 mm (a 100 mm margin) at 50 mm/s, too far creeps in DEPOSIT_APPROACH at 35 mm/s until 420 mm, so the last correction is always made moving forward. Inside the band it lights LED1 green and returns to IDLE; LED1 is yellow while adjusting." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1390" y="1835" width="420" height="380" as="geometry"/></mxCell><mxCell id="note_col5" value="&lt;b&gt;Constants (Src/Helper/helper.h)&lt;/b&gt;&lt;br&gt;Scan: turn speed 150, give-up after a full turn of 360. Layout split 575 mm (B below, A otherwise). Orient A -75 / B +108. Pathfind: drive speed 150, reverse 50 mm, wall-hit nudge A -5 / B +5 (ledge cliff: the opposite), corridor turn A +90 / B -90. Storage: turn A +131 / B -131, drive-in 900 mm. Detect range 750 mm (Src/Ultrasonic/ultrasonic.h). The Kobuki speed limit is 150 mm/s.&lt;br&gt;&lt;br&gt;Deposit: scan speed 50, align tolerance 100 ticks, refine sweep +/-25 deg in 2 deg steps at 35 with a 50 tick tolerance, 10 mm range band, 5 Ticks between readings, settle 15 Ticks, target 410 mm, tolerance 10 mm, reverse margin 100 mm, reverse speed 50, approach speed 35. DEPOSIT_TEST_MODE 0.&lt;br&gt;&lt;br&gt;&lt;b&gt;Helpers (Src/Helper/helper.c)&lt;/b&gt;&lt;br&gt;Layout_From_Range(range_mm) is the single split; Layout_Pick(a, b) picks a value by Layout. Scan_Sample() = Scan_Update_Turn(kobuki.angle) + Ultrasonic_Detect(&amp;amp;object); Scan_Gave_Up() = scan_deg &gt;= 360. Corridor_Take_Wall_Hit() and Corridor_Take_Ledge_Hit() test the Layout&#x27;s side and latch pathfind_recover_deg. Deposit_*() keep the closest echo, drive the refine sweep and read the live range." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1840" y="1835" width="420" height="380" as="geometry"/></mxCell><mxCell id="idle_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&lt;b&gt;exit /&lt;/b&gt; layout = none&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.detected = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;heading = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;corridor = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Scan_Start(kobuki.angle)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="idle"><mxGeometry x="0" y="26" width="300" height="114" as="geometry"/></mxCell><mxCell id="search_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;do /&lt;/b&gt; Scan_Sample()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(150)&amp;nbsp;&amp;nbsp;// ACW&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="search"><mxGeometry x="0" y="26" width="260" height="54" as="geometry"/></mxCell><mxCell id="identify_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; layout = Layout_From_Range(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.range_mm)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Update_LEDs(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;A: RED, B: YELLOW, OFF)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="identify"><mxGeometry x="0" y="26" width="300" height="94" as="geometry"/></mxCell><mxCell id="d_app_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;do /&lt;/b&gt; Deposit_Read_Range()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Drive(35)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// creep forward to the target&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="d_app"><mxGeometry x="0" y="26" width="310" height="54" as="geometry"/></mxCell><mxCell id="d_dist_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;deposit_settle_packets = 15&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Update_LEDs(YELLOW, OFF)&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Deposit_Read_Range()&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// first 15 Ticks: Kobuki_Drive(STOP)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;//&amp;nbsp;&amp;nbsp; and no reading (sonar catches up)&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="d_dist"><mxGeometry x="0" y="26" width="310" height="96" as="geometry"/></mxCell><mxCell id="d_rev_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;do /&lt;/b&gt; Deposit_Read_Range()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Drive(-50)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// back off past the target&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="d_rev"><mxGeometry x="0" y="26" width="310" height="54" as="geometry"/></mxCell><mxCell id="d_align_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;do /&lt;/b&gt; turn = Deposit_Rod_Turn_Ticks()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(sign(turn) * speed)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// coarse: 50 mm/s, 100 ticks&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// refined: 35 mm/s, 50 ticks&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// 1 tick = 0.01 deg&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="d_align"><mxGeometry x="0" y="26" width="310" height="82" as="geometry"/></mxCell><mxCell id="d_rturn_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;do /&lt;/b&gt; turn = Deposit_Refine_Turn_Ticks()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(sign(turn) * 35)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// to the next of 26 steps,&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// -25 to +25 deg, 2 deg apart&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="d_rturn"><mxGeometry x="0" y="26" width="310" height="68" as="geometry"/></mxCell><mxCell id="deposit_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Deposit_Scan_Start(kobuki.angle)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Update_LEDs(OFF, OFF)&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Deposit_Scan_Sample()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(50)&amp;nbsp;&amp;nbsp;// ACW&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="deposit"><mxGeometry x="0" y="26" width="310" height="82" as="geometry"/></mxCell><mxCell id="d_rsample_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Deposit_Refine_Settle()&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Deposit_Refine_Sample()&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// settle 15 Ticks, then 3 readings&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// 5 Ticks apart; the median is kept&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="d_rsample"><mxGeometry x="0" y="26" width="310" height="96" as="geometry"/></mxCell><mxCell id="drive_in_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive_Distance_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.distance, 900)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// through the Entrance&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive_Distance(kobuki.distance)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="drive_in"><mxGeometry x="0" y="26" width="310" height="68" as="geometry"/></mxCell><mxCell id="turn_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: +131, B: -131)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// A: ACW, B: CW, to the Entrance&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="turn"><mxGeometry x="0" y="26" width="310" height="68" as="geometry"/></mxCell><mxCell id="p_drive_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive(150)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// at the speed limit&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="p_drive"><mxGeometry x="0" y="26" width="320" height="54" as="geometry"/></mxCell><mxCell id="p_creverse_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive_Distance_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.distance, -50)&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive_Distance(kobuki.distance)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// bumper and cliff are ignored here&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="p_creverse"><mxGeometry x="0" y="26" width="320" height="68" as="geometry"/></mxCell><mxCell id="p_cturn_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: +90, B: -90)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// A: ACW, B: CW&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;&lt;b&gt;exit /&lt;/b&gt; heading = kobuki.angle&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// bumper and cliff are ignored here&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="p_cturn"><mxGeometry x="0" y="26" width="320" height="98" as="geometry"/></mxCell><mxCell id="p_cstop_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="p_cstop"><mxGeometry x="0" y="26" width="230" height="28" as="geometry"/></mxCell><mxCell id="p_reverse_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive_Distance_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.distance, -50)&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive_Distance(kobuki.distance)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// bumper and cliff are ignored here&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="p_reverse"><mxGeometry x="0" y="26" width="320" height="68" as="geometry"/></mxCell><mxCell id="p_rotate_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, pathfind_recover_deg)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// latched in DRIVE: wall A -5, B +5;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// ledge A +5, B -5&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// bumper and cliff are ignored here&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="p_rotate"><mxGeometry x="0" y="26" width="320" height="98" as="geometry"/></mxCell><mxCell id="orient_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: -75, B: +108)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// A: CW, B: ACW&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="orient"><mxGeometry x="0" y="26" width="300" height="94" as="geometry"/></mxCell><mxCell id="fault_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&lt;/div&gt;" style="text;html=1;ali