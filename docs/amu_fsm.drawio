Perimeter=0;" edge="1" parent="1" source="storage" target="fault"><mxGeometry relative="1" as="geometry"><mxPoint x="-55.0" y="-1.5" as="offset"/></mxGeometry></mxCell><mxCell id="e_fault_idle" value="ε" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.0000;exitY=0.5283;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8400;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="fault" target="idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="708"/></Array><mxPoint x="65.0" y="136.0" as="offset"/></mxGeometry></mxCell><mxCell id="e_deposit_idle" value="ε&lt;br&gt;(stub: at once)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.0500;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2400;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="deposit" target="idle"><mxGeometry relative="1" as="geometry"><mxPoint x="48.0" y="-24.0" as="offset"/></mxGeometry></mxCell><mxCell id="e_turn_drivein" value="kobuki.rotation_complete" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="turn" target="drive_in"><mxGeometry relative="1" as="geometry"><mxPoint x="75.0" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="e_drivein_deposit_bump" value="1: any kobuki.bumper bit&lt;br&gt;/ Kobuki_Drive(STOP)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.1250;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1250;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="drive_in" target="deposit"><mxGeometry relative="1" as="geometry"><mxPoint x="80.0" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="e_drivein_deposit_done" value="2: kobuki.&lt;br&gt;distance_complete" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.8500;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8500;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="drive_in" target="deposit"><mxGeometry relative="1" as="geometry"><mxPoint x="-58.0" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="p_drive_reverse" value="&lt;div style=&quot;text-align:left&quot;&gt;2: storage wall bumper&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[A: kobuki.bumper &amp;amp; 0x01, B: kobuki.bumper &amp;amp; 0x04]&lt;br&gt;3: ledge cliff&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[A: kobuki.cliff &amp;amp; 0x04, B: kobuki.cliff &amp;amp; 0x01]&lt;/div&gt;" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.8529;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8529;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p_drive" target="p_reverse"><mxGeometry relative="1" as="geometry"><mxPoint x="-160.0" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="p_reverse_rotate" value="kobuki.distance_complete" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p_reverse" target="p_rotate"><mxGeometry relative="1" as="geometry"><mxPoint x="78.0" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="p_rotate_drive" value="kobuki.&lt;br&gt;rotation_&lt;br&gt;complete" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=1.0000;exitY=0.2778;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.2985;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p_rotate" target="p_drive"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1770" y="1320"/><mxPoint x="1770" y="920"/></Array><mxPoint x="45.0" y="5.0" as="offset"/></mxGeometry></mxCell><mxCell id="p_drive_choice" value="1: corridor length&lt;br&gt;[net travel &amp;gt;= 1200 mm]" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.0000;exitY=0.2985;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p_drive" target="p_choice"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-32.0" as="offset"/></mxGeometry></mxCell><mxCell id="p_choice_turn" value="[corridor == 1]" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.7765;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p_choice" target="p_cturn"><mxGeometry relative="1" as="geometry"><mxPoint x="-52.0" y="0.0" as="offset"/></mxGeometry></mxCell><mxCell id="p_choice_stop" value="[corridor == 2]" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p_choice" target="p_cstop"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="745" y="920.0"/></Array><mxPoint x="177.5" y="-12.0" as="offset"/></mxGeometry></mxCell><mxCell id="p_turn_drive" value="kobuki.rotation_complete&lt;br&gt;/ corridor = 2,&lt;br&gt;corridor_start_distance =&lt;br&gt;kobuki.distance" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=1.0000;exitY=0.3889;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.7463;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p_cturn" target="p_drive"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="1132"/><mxPoint x="1350" y="950"/></Array><mxPoint x="-82.0" y="-31.0" as="offset"/></mxGeometry></mxCell><mxCell id="p_stop_turn" value="ε" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.0000;exitY=0.3774;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.4787;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p_cstop" target="turn"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-14.0" as="offset"/></mxGeometry></mxCell><mxCell id="lg_dot" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="44" y="1476" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_dot_t" value="start (initial State)" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="1476" width="150" height="18" as="geometry"/></mxCell><mxCell id="lg_dia" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="230" y="1470" width="28" height="28" as="geometry"/></mxCell><mxCell id="lg_dia_t" value="choice: one trigger, the guard on each edge picks the way" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="266" y="1476" width="340" height="18" as="geometry"/></mxCell><mxCell id="lg_st" value="state" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="1470" width="90" height="30" as="geometry"/></mxCell><mxCell id="lg_fa" value="fault" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="750" y="1470" width="90" height="30" as="geometry"/></mxCell><mxCell id="lg_su" value="composite (sub-FSM)" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="860" y="1470" width="170" height="30" as="geometry"/></mxCell><mxCell id="lg_stub" value="stub" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="1050" y="1470" width="90" height="30" as="geometry"/></mxCell><mxCell id="lg_red" value="&lt;font color=&quot;#b85450&quot;&gt;red edge&lt;/font&gt; = fault: the State leaves for STOP / FAULT" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1170" y="1476" width="600" height="18" as="geometry"/></mxCell><mxCell id="note1" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;A State is a rounded box: its name, then its actions. &lt;b&gt;entry /&lt;/b&gt; runs once on entering, &lt;b&gt;do /&lt;/b&gt; on every Tick in which no edge fired, &lt;b&gt;exit /&lt;/b&gt; once on leaving. Edges read: trigger [guard] / effect. A State&#x27;s edges are checked in priority order and the first true one fires; a transition runs exit(), then the effect, then entry() of the next State.&lt;br&gt;&lt;br&gt;&lt;b&gt;ε&lt;/b&gt; = no trigger: the edge is taken on the next Tick. One Tick = one Kobuki packet: Kobuki_Read() runs first, then FSM_Tick().&lt;br&gt;&lt;br&gt;Angles are degrees: + = ACW (left), - = CW (right) (Kobuki_Rotate: +ve is CCW). &lt;b&gt;heading&lt;/b&gt; = kobuki.angle, latched at the start of each corridor.&lt;br&gt;&lt;br&gt;Setpoints (Kobuki_Rotate_Angle_Setpoint, Kobuki_Drive_Distance_Setpoint) are one-shot entry actions. kobuki.rotation_complete and kobuki.distance_complete are copied at the top of the Tick, so a State sees them one Tick after its last do / call." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1526" width="570" height="250" as="geometry"/></mxCell><mxCell id="note2" value="&lt;b&gt;Layouts&lt;/b&gt;&lt;br&gt;A / B is the Layout saved by SEARCH, never a live reading. Layout A: bollards A1/A2 block the left/top route, so the AMU takes the bottom corridor, then the right corridor; the storage wall is on its right and the ledge on its left. Layout B is the mirror image: bollards B1/B2 block the bottom/right route.&lt;br&gt;&lt;br&gt;&lt;b&gt;Sensors&lt;/b&gt;&lt;br&gt;Bumper / cliff bits: right = 0x01, centre = 0x02, left = 0x04. B0 = kobuki.button &amp;amp; 0x01 (start). B1 = kobuki.button &amp;amp; 0x02 (stop). wheeldrop = kobuki.wheeldrop != 0.&lt;br&gt;&lt;br&gt;&lt;b&gt;Faults&lt;/b&gt;&lt;br&gt;The sensor fault edge is the first edge of its State, so it wins. B1 | wheeldrop leaves every State except IDLE. SEARCH, DETECT, SPIN and ORIENT also fault on any bumper or cliff; ALIGN on any bumper (cliff ignored). Bumpers and cliffs are expected in PATHFIND and STORAGE, so those regions have one red edge each, for B1 | wheeldrop only. There are no timeouts." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="1526" width="570" height="250" as="geometry"/></mxCell><mxCell id="note3" value="&lt;b&gt;Constants&lt;/b&gt; (Src/FSM_state/fsm_states.h)&lt;br&gt;path speed 100, corridor length 1200 mm, reverse 50 mm, Rotate A +10 / B -10, corner A +90 / B -90, Orient A +90 / B -90, Align +13, Spin Step +15, max Sweeps 2, storage turn A +135 / B -135, drive-in 1000 mm, layout ranges 300 / 500 / 650 mm, detect range 700 mm.&lt;br&gt;&lt;br&gt;&lt;b&gt;Helpers&lt;/b&gt; (Src/Helper/helper.h)&lt;br&gt;Layout_From_Range() is the logic SEARCH writes out. Angle_Delta_Deg() is the shortest signed angle that SPIN adds up (ROTATE uses a fixed nudge, not Angle_Delta_Deg).&lt;br&gt;&lt;br&gt;&lt;b&gt;IDLE reset&lt;/b&gt;&lt;br&gt;IDLE clears the SEARCH variables on exit, because DETECT and SPIN re-enter SEARCH and it cannot reset itself.&lt;br&gt;&lt;br&gt;&lt;b&gt;ALIGN offset&lt;/b&gt; (+13, tuned on the hardware)&lt;br&gt;To re-measure: take at least 8 random start headings per Layout, run SEARCH to its stop, jog to the bollard centre and record the turn. The median is the offset; the spread is the accuracy ALIGN will have. If the Layout medians differ by more than the spread, use one offset per Layout. If the spread is too big, sweep ACW to the far edge and turn back half the span." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1240" y="1526" width="570" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>