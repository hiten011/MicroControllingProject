<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.5"><diagram id="amu_fsm" name="AMU FSM"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1930" pageHeight="1806" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;AMU parcel-run FSM&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=20;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="One box per State in Src/FSM_state/states/*.c. UML state-machine notation: trigger [guard] / effect. Terms follow GLOSSARY.md. A / B is the Layout learned by SEARCH." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1700" height="18" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="141" y="94" width="16" height="16" as="geometry"/></mxCell><mxCell id="idle" value="IDLE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="250" height="148" as="geometry"/></mxCell><mxCell id="idle_body" value="&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&lt;b&gt;exit /&lt;/b&gt; layout = none&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.detected = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;swept_deg = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sweep_count = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;last_angle = kobuki.angle&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;heading = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;corridor = 0" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="idle"><mxGeometry y="26" width="250" height="122" as="geometry"/></mxCell><mxCell id="search" value="SEARCH" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="470" y="130" width="440" height="135" as="geometry"/></mxCell><mxCell id="search_body" value="&lt;b&gt;entry /&lt;/b&gt; if object.detected:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;layout = Layout_From_Range(range_mm)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// 500 &amp;lt; range_mm &amp;lt;= 650&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;A (far bollard)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// 300 &amp;lt;= range_mm &amp;lt;= 500&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;B (near bollard)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// anything else&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;none&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// range_mm = object.range_mm of the last DETECT;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// the layout is overwritten at every Detection&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="search"><mxGeometry y="26" width="440" height="109" as="geometry"/></mxCell><mxCell id="align" value="ALIGN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1040" y="130" width="350" height="108" as="geometry"/></mxCell><mxCell id="align_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, +13)&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// ACW&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// first-detection heading&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;//&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; centre heading&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="align"><mxGeometry y="26" width="350" height="82" as="geometry"/></mxCell><mxCell id="orient" value="ORIENT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1500" y="130" width="380" height="108" as="geometry"/></mxCell><mxCell id="orient_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: +90, B: -90)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// A: ACW, B: CW&amp;nbsp;&amp;nbsp;(centre heading&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;//&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;gt; first corridor)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="orient"><mxGeometry y="26" width="380" height="82" as="geometry"/></mxCell><mxCell id="detect" value="DETECT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="375" width="350" height="94" as="geometry"/></mxCell><mxCell id="detect_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// hold still&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Ultrasonic_Detect(&amp;amp;object):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.range_mm = ultrasonic reading&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.detected = (range_mm &amp;lt; 700)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="detect"><mxGeometry y="26" width="350" height="68" as="geometry"/></mxCell><mxCell id="spin" value="SPIN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1060" y="375" width="330" height="162" as="geometry"/></mxCell><mxCell id="spin_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, +15)&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// one Step, ACW&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;&lt;b&gt;exit /&lt;/b&gt; swept_deg += Angle_Delta_Deg(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;last_angle, kobuki.angle)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;last_angle = kobuki.angle&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if swept_deg &amp;gt;= 360:&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// one Sweep&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;swept_deg -= 360&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sweep_count++" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="spin"><mxGeometry y="26" width="330" height="136" as="geometry"/></mxCell><mxCell id="fault" value="STOP / FAULT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;swimlaneFillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="380" y="680" width="1100" height="53" as="geometry"/></mxCell><mxCell id="fault_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="fault"><mxGeometry y="26" width="1100" height="27" as="geometry"/></mxCell><mxCell id="storage" value="STORAGE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="480" height="590" as="geometry"/></mxCell><mxCell id="pathfind" value="PATHFIND" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="610" y="840" width="1280" height="590" as="geometry"/></mxCell><mxCell id="deposit" value="DEPOSIT  (stub)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;dashed=1;dashPattern=6 3;" vertex="1" parent="storage"><mxGeometry x="40" y="50" width="400" height="80" as="geometry"/></mxCell><mxCell id="deposit_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// stub: deposit-location sensing&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;//&amp;nbsp;&amp;nbsp;&amp;nbsp;is not built yet&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="deposit"><mxGeometry y="26" width="400" height="54" as="geometry"/></mxCell><mxCell id="drive_in" value="DRIVE_IN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="40" y="230" width="400" height="94" as="geometry"/></mxCell><mxCell id="drive_in_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive_Distance_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.distance, 1000)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// through the Entrance&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive_Distance(kobuki.distance)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="drive_in"><mxGeometry y="26" width="400" height="68" as="geometry"/></mxCell><mxCell id="turn" value="TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="40" y="410" width="400" height="94" as="geometry"/></mxCell><mxCell id="turn_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: +135, B: -135)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// A: ACW, B: CW&amp;nbsp;&amp;nbsp;(face the Entrance)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="turn"><mxGeometry y="26" width="400" height="68" as="geometry"/></mxCell><mxCell id="storage_note" value="Bumper and cliff are ignored in TURN (the turn is made beside the ledge). DRIVE_IN ignores the cliff; any bumper ends it in DEPOSIT." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="storage"><mxGeometry x="20" y="522" width="440" height="50" as="geometry"/></mxCell><mxCell id="p_drive" value="DRIVE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="780" y="60" width="340" height="67" as="geometry"/></mxCell><mxCell id="p_drive_body" value="&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive(100)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// below the speed limit of 150&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_drive"><mxGeometry y="26" width="340" height="41" as="geometry"/></mxCell><mxCell id="p_reverse" value="REVERSE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="780" y="260" width="340" height="94" as="geometry"/></mxCell><mxCell id="p_reverse_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive_Distance_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.distance, -50)&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive_Distance(kobuki.distance)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// bumper and cliff are ignored here&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_reverse"><mxGeometry y="26" width="340" height="68" as="geometry"/></mxCell><mxCell id="p_rotate" value="ROTATE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="780" y="450" width="340" height="108" as="geometry"/></mxCell><mxCell id="p_rotate_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: +10, B: -10)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// fixed nudge, ignores heading&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// bumper and cliff are ignored here&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_rotate"><mxGeometry y="26" width="340" height="82" as="geometry"/></mxCell><mxCell id="p_cturn" value="CORRIDOR_TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="290" y="250" width="340" height="108" as="geometry"/></mxCell><mxCell id="p_cturn_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: +90, B: -90)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// A: ACW, B: CW&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;&lt;b&gt;exit /&lt;/b&gt; heading = kobuki.angle" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_cturn"><mxGeometry y="26" width="340" height="82" as="geometry"/></mxCell><mxCell id="p_cstop" value="CORRIDOR_STOP" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="30" y="435" width="210" height="53" as="geometry"/></mxCell><mxCell id="p_cstop_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_cstop"><mxGeometry y="26" width="210" height="27" as="geometry"/></mxCell><mxCell id="p_choice" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1150" y="906" width="28" height="28" as="geometry"/></mxCell><mxCell id="pathfind_note" value="One sub-FSM, run twice: corridor = 1 (ends in CORRIDOR_TURN), then corridor = 2 (ends in CORRIDOR_S