<mxfile host="app.diagrams.net" agent="amu-fsm-generator" version="24.7.5"><diagram id="amu_fsm" name="AMU FSM"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="search_phase" value="SEARCH (phase)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="800" height="200" as="geometry"/></mxCell><mxCell id="storage" value="STORAGE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="500" height="660" as="geometry"/></mxCell><mxCell id="pathfind" value="PATHFIND" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="600" y="620" width="1310" height="660" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;AMU parcel-run FSM&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=20;fontFamily=Helvetica;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="One box per State in the Src/main.c switch (the ST_* enum). UML state-machine notation: trigger [guard] / effect. Terms follow GLOSSARY.md. A / B is the Layout learned by IDENTIFY." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1800" height="18" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="152" y="100" width="16" height="16" as="geometry"/></mxCell><mxCell id="idle" value="IDLE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="240" height="134" as="geometry"/></mxCell><mxCell id="search" value="SEARCH" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="search_phase"><mxGeometry x="30" y="70" width="260" height="70" as="geometry"/></mxCell><mxCell id="identify" value="IDENTIFY" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="search_phase"><mxGeometry x="460" y="70" width="300" height="70" as="geometry"/></mxCell><mxCell id="orient" value="ORIENT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1390" y="180" width="300" height="110" as="geometry"/></mxCell><mxCell id="fault" value="STOP / FAULT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;swimlaneFillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="440" y="440" width="1030" height="54" as="geometry"/></mxCell><mxCell id="p_drive" value="DRIVE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="780" y="80" width="320" height="80" as="geometry"/></mxCell><mxCell id="p_choice" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1096" y="706" width="28" height="28" as="geometry"/></mxCell><mxCell id="p_creverse" value="CORRIDOR_REVERSE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="350" y="220" width="320" height="94" as="geometry"/></mxCell><mxCell id="p_cturn" value="CORRIDOR_TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="350" y="390" width="320" height="124" as="geometry"/></mxCell><mxCell id="p_cstop" value="CORRIDOR_STOP" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="50" y="474" width="240" height="54" as="geometry"/></mxCell><mxCell id="p_reverse" value="REVERSE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="780" y="310" width="320" height="94" as="geometry"/></mxCell><mxCell id="p_rotate" value="ROTATE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="780" y="470" width="320" height="124" as="geometry"/></mxCell><mxCell id="pathfind_note" value="Runs twice: corridor = 1 ends in CORRIDOR_REVERSE, then CORRIDOR_TURN; corridor = 2 ends in CORRIDOR_STOP. A corridor ends on the front cliff, not on distance. DRIVE ignores the ledge-side bumper and the storage-wall-side cliff; REVERSE, ROTATE and the CORRIDOR_ States ignore bumper and cliff. Only B1 | wheeldrop faults here." style="shape=note;size=10;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#808080;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=10.5;fontFamily=Helvetica;fontColor=#444444;" vertex="1" parent="pathfind"><mxGeometry x="40" y="576" width="660" height="58" as="geometry"/></mxCell><mxCell id="deposit" value="DEPOSIT (stub)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;dashed=1;dashPattern=5 3;" vertex="1" parent="storage"><mxGeometry x="50" y="70" width="400" height="80" as="geometry"/></mxCell><mxCell id="drive_in" value="DRIVE_IN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="50" y="250" width="400" height="94" as="geometry"/></mxCell><mxCell id="turn" value="TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="50" y="454" width="400" height="94" as="geometry"/></mxCell><mxCell id="storage_note" value="TURN ignores bumper and cliff (the turn is made beside the ledge). DRIVE_IN ignores the cliff; any bumper ends it in DEPOSIT. Only B1 | wheeldrop faults here." style="shape=note;size=10;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#808080;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=10.5;fontFamily=Helvetica;fontColor=#444444;" vertex="1" parent="storage"><mxGeometry x="30" y="580" width="460" height="46" as="geometry"/></mxCell><mxCell id="lg_dot" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="44" y="1336" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_dot_t" value="start (initial State)" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="1336" width="150" height="18" as="geometry"/></mxCell><mxCell id="lg_dia" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="230" y="1330" width="28" height="28" as="geometry"/></mxCell><mxCell id="lg_dia_t" value="choice: one trigger, the guard on each edge picks the way" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="266" y="1336" width="350" height="18" as="geometry"/></mxCell><mxCell id="lg_st" value="state" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="1329" width="90" height="30" as="geometry"/></mxCell><mxCell id="lg_fa" value="fault" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;fontSize=11;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="770" y="1329" width="90" height="30" as="geometry"/></mxCell><mxCell id="lg_su" value="composite (phase)" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;fontSize=11;fontFamily=Helvetica;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="1329" width="170" height="30" as="geometry"/></mxCell><mxCell id="lg_stub" value="stub" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="1080" y="1329" width="90" height="30" as="geometry"/></mxCell><mxCell id="lg_red" value="&lt;font color=&quot;#b85450&quot;&gt;red edge&lt;/font&gt; = fault: the State leaves for STOP / FAULT" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1190" y="1336" width="700" height="18" as="geometry"/></mxCell><mxCell id="note_col1" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;A State is a rounded box: its name, then its actions. &lt;b&gt;entry /&lt;/b&gt; runs once on entering, &lt;b&gt;do /&lt;/b&gt; on every Tick in which no edge fired, &lt;b&gt;exit /&lt;/b&gt; once on leaving. Edges read: trigger [guard] / effect. A State&#x27;s edges are checked in priority order, the red fault edge first, and the first true one fires; a transition runs exit(), then the effect, then entry() of the next State. 1:, 2:, 3: number the edges that share a source.&lt;br&gt;&lt;br&gt;&lt;b&gt;ε&lt;/b&gt; = no trigger: the edge is taken on the next Tick. One Tick = one Kobuki packet: Kobuki_Read() runs first, then the state switch.&lt;br&gt;&lt;br&gt;Angles are degrees: + = ACW (left), - = CW (right). &lt;b&gt;heading&lt;/b&gt; = kobuki.angle, latched when ORIENT completes and when CORRIDOR_TURN is left.&lt;br&gt;&lt;br&gt;Setpoints (Kobuki_Rotate_Angle_Setpoint, Kobuki_Drive_Distance_Setpoint) are one-shot entry actions. kobuki.rotation_complete and kobuki.distance_complete are copied at the top of the Tick by Kobuki_Read(), so a State sees them one Tick after its last do / call." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1400" width="440" height="330" as="geometry"/></mxCell><mxCell id="note_col2" value="&lt;b&gt;Layouts&lt;/b&gt;&lt;br&gt;A / B is the Layout saved by IDENTIFY, never a live reading. Layout A: bollards A1/A2 block the left/top route; ORIENT turns clockwise to the bottom corridor; the storage wall is on the AMU&#x27;s left and the ledge on its right. Layout B is the mirror image: bollards B1/B2 block the bottom/right route; ORIENT turns anticlockwise to the left corridor.&lt;br&gt;&lt;br&gt;&lt;b&gt;Sensors&lt;/b&gt;&lt;br&gt;Bumper / cliff bits: right = 0x01, centre = 0x02, left = 0x04. B0 = kobuki.button &amp;amp; 0x01 (start). B1 = kobuki.button &amp;amp; 0x02 (stop). Fault_B1_Wheeldrop() = B1 | kobuki.wheeldrop != 0. Fault_Any() = that | any bumper | any cliff.&lt;br&gt;&lt;br&gt;&lt;b&gt;Faults&lt;/b&gt;&lt;br&gt;B1 | wheeldrop leaves every State except IDLE and STOP / FAULT. SEARCH, IDENTIFY and ORIENT also fault on any bumper or cliff. Bumpers and cliffs are expected in PATHFIND and STORAGE, so those regions have one red edge each, for B1 | wheeldrop only. The only timeout is the SEARCH give-up. STOP / FAULT stops the motors and returns to IDLE on the next Tick." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="530" y="1400" width="440" height="330" as="geometry"/></mxCell><mxCell id="note_col3" value="&lt;b&gt;Search phase&lt;/b&gt;&lt;br&gt;SEARCH turns anticlockwise on the spot from B0 and reads the ultrasonic once per Tick. &lt;b&gt;scan_deg&lt;/b&gt; is the net turn since B0 in degrees, ACW positive, summed from gyro changes so it does not wrap at 180; it only drives the give-up (scan_deg &gt;= 360: LED1 green, then FAULT). A Detection is range_mm &amp;lt; 750. IDENTIFY stops on the first Detection, then layout = Layout_From_Range(range_mm): B when range_mm &amp;lt; 575, otherwise A. LED1 red for A, yellow for B. There is no centring: ORIENT turns from wherever SEARCH stopped.&lt;br&gt;&lt;br&gt;&lt;b&gt;IDLE reset&lt;/b&gt;&lt;br&gt;Leaving IDLE (B0) clears layout, object.detected, heading and corridor, and zeroes the scan with Scan_Start().&lt;br&gt;&lt;br&gt;&lt;b&gt;Calibration (layout split, detect range)&lt;/b&gt;&lt;br&gt;The split is a calibration value (575 mm now). IDENTIFY reads the first in-range reading, taken as the sonar beam first reaches the bollard, so calibrate the same way: turn the AMU anticlockwise onto B1, then onto A1, and read robot.object.range_mm when SEARCH stops; the split goes between them. The detect range must stay above the A1 reading and below the nearest wall." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1020" y="1400" width="440" height="330" as="geometry"/></mxCell><mxCell id="note_col4" value="&lt;b&gt;Constants (Src/Helper/helper.h)&lt;/b&gt;&lt;br&gt;Scan: turn speed 150, give-up after a full turn of 360. Layout split 575 mm (B below, A otherwise). Orient A -75 / B +108. Pathfind: drive speed 150, reverse 50 mm, wall-hit nudge A -5 / B +5 (ledge cliff: the opposite), corridor turn A +90 / B -90. Storage: turn A +131 / B -131, drive-in 900 mm. Detect range 750 mm (Src/Ultrasonic/ultrasonic.h). The Kobuki speed limit is 150 mm/s.&lt;br&gt;&lt;br&gt;&lt;b&gt;Helpers (Src/Helper/helper.c)&lt;/b&gt;&lt;br&gt;Layout_From_Range(range_mm) is the single split; Layout_Pick(a, b) picks a value by Layout. Scan_Sample() = Scan_Update_Turn(kobuki.angle) + Ultrasonic_Detect(&amp;amp;object); Scan_Gave_Up() = scan_deg &gt;= 360. Corridor_Take_Wall_Hit() and Corridor_Take_Ledge_Hit() test the Layout&#x27;s side and latch pathfind_recover_deg." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1510" y="1400" width="440" height="330" as="geometry"/></mxCell><mxCell id="idle_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&lt;b&gt;exit /&lt;/b&gt; layout = none&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.detected = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;heading = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;corridor = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Scan_Start(kobuki.angle)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="idle"><mxGeometry x="0" y="26" width="240" height="108" as="geometry"/></mxCell><mxCell id="search_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;do /&lt;/b&gt; Scan_Sample()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(150)&amp;nbsp;&amp;nbsp;// ACW&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="search"><mxGeometry x="0" y="26" width="260" height="44" as="geometry"/></mxCell><mxCell id="identify_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="identify"><mxGeometry x="0" y="26" width="300" height="44" as="geometry"/></mxCell><mxCell id="orient_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: -75, B: +108)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// A: CW, B: ACW&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="orient"><mxGeometry x="0" y="26" width="300" height="84" as="geometry"/></mxCell><mxCell id="fault_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="fault"><mxGeometry x="0" y="26" width="1030" height="28" as="geometry"/></mxCell><mxCell id="p_drive_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive(150)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// at the speed limit&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="p_drive"><mxGeometry x="0" y="26" width="320" height="54" as="geometry"/></mxCell><mxCell id="p_creverse_body" value="&lt;div style=&quot;line-height:14px&quot;&gt;&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive_Distance_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.distance, -50)&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive_Distance(kobuki.distance)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// bumper and cliff are ignored here&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=nowrap;" vertex="1" parent="p_creverse"><mxGeometry x="0" y="26" width="320" hei