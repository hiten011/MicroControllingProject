<mxfile host="app.diagrams.net" agent="hiten" version="24.7.5"><diagram id="amu_fsm" name="AMU FSM"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1930" pageHeight="1806" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;AMU parcel-run FSM&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=20;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="subtitle" value="One box per State in the Src/main.c switch. UML state-machine notation: trigger [guard] / effect. Terms follow GLOSSARY.md. A / B is the Layout learned by DETECT." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1700" height="18" as="geometry" /></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="132" y="434" width="16" height="16" as="geometry" /></mxCell><mxCell id="idle" value="IDLE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="230" height="136" as="geometry" /></mxCell><mxCell id="idle_body" value="&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&lt;b&gt;exit /&lt;/b&gt; layout = none&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.detected = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;heading = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;corridor = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Scan_Start(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="idle"><mxGeometry x="0" y="26" width="230" height="110" as="geometry" /></mxCell><mxCell id="search_phase" value="SEARCH (phase)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="400" y="96" width="1090" height="513" as="geometry" /></mxCell><mxCell id="detect" value="DETECT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="search_phase"><mxGeometry x="740" y="44" width="330" height="66" as="geometry" /></mxCell><mxCell id="detect_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// then classify closest_mm&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="detect"><mxGeometry x="0" y="26" width="330" height="40" as="geometry" /></mxCell><mxCell id="edge_scan" value="EDGE_SCAN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="search_phase"><mxGeometry x="740" y="176" width="330" height="141" as="geometry" /></mxCell><mxCell id="edge_scan_body" value="&lt;b&gt;entry /&lt;/b&gt; edge_mm = closest_mm + 60&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; scan_sample()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;closest_mm = min reading&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;edge_start_deg / edge_end_deg =&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;lowest / highest scan_deg&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;with range_mm &amp;lt;= edge_mm&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(-40)  &lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// CW, slow&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="edge_scan"><mxGeometry x="0" y="26" width="330" height="115" as="geometry" /></mxCell><mxCell id="track" value="TRACK" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="search_phase"><mxGeometry x="740" y="383" width="330" height="96" as="geometry" /></mxCell><mxCell id="track_body" value="&lt;b&gt;do /&lt;/b&gt; scan_sample()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;last_seen_deg = scan_deg and&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;closest_mm = min, if detected&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(+100)  &lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// ACW&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="track"><mxGeometry x="0" y="26" width="330" height="70" as="geometry" /></mxCell><mxCell id="search" value="SEARCH" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="search_phase"><mxGeometry x="380" y="383" width="250" height="81" as="geometry" /></mxCell><mxCell id="search_body" value="&lt;b&gt;do /&lt;/b&gt; scan_sample()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(+100)  &lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// ACW&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// until something is near&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="search"><mxGeometry x="0" y="26" width="250" height="55" as="geometry" /></mxCell><mxCell id="clear" value="CLEAR" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="search_phase"><mxGeometry x="20" y="383" width="250" height="81" as="geometry" /></mxCell><mxCell id="clear_body" value="&lt;b&gt;do /&lt;/b&gt; scan_sample()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(-100)  &lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// CW&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// until nothing is near&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="clear"><mxGeometry x="0" y="26" width="250" height="55" as="geometry" /></mxCell><mxCell id="search_phase_note" value="&lt;b&gt;Search phase&lt;/b&gt;&lt;br&gt;The AMU turns on the spot and reads the ultrasonic once per Tick while it turns (scan_sample() = Scan_Update_Turn(kobuki.angle) + Ultrasonic_Detect(&amp;amp;object); object.detected = range_mm &amp;lt; 750). &lt;b&gt;scan_deg&lt;/b&gt; is the net turn since B0 in degrees, ACW positive, summed from gyro changes so it does not wrap at 180. Every bearing below (first_seen_deg, last_seen_deg, edge_start_deg, edge_end_deg, centre_deg) is a scan_deg.&lt;br&gt;&lt;br&gt;&lt;b&gt;Give up&lt;/b&gt; (scan_give_up(): LED1 green, then STOP / FAULT): CLEAR when scan_deg &amp;lt;= -360; SEARCH when scan_deg &amp;gt;= 400; TRACK when the object is still in view 360 after first_seen_deg; EDGE_SCAN when scan_deg &amp;lt;= first_seen_deg - 40.&lt;br&gt;&lt;br&gt;&lt;b&gt;Detect&lt;/b&gt;: layout = Layout_From_Range(closest_mm), which is B when closest_mm &amp;lt; 575, otherwise A. LED1 red for A, yellow for B. ALIGN then turns by centre_deg - scan_deg." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="search_phase"><mxGeometry x="20" y="48" width="690" height="262" as="geometry" /></mxCell><mxCell id="align" value="ALIGN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1600" y="119.5" width="320" height="107" as="geometry" /></mxCell><mxCell id="align_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, centre_deg - scan_deg)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// ACW: turn to the bollard centre&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="align"><mxGeometry x="0" y="26" width="320" height="81" as="geometry" /></mxCell><mxCell id="orient" value="ORIENT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1600" y="330" width="320" height="111" as="geometry" /></mxCell><mxCell id="orient_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: -90, B: +90)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// A: CW, B: ACW  (centre heading&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;//   -&amp;gt; first corridor)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="orient"><mxGeometry x="0" y="26" width="320" height="85" as="geometry" /></mxCell><mxCell id="fault" value="STOP / FAULT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;swimlaneFillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="380" y="680" width="1180" height="53" as="geometry" /></mxCell><mxCell id="fault_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="fault"><mxGeometry y="26" width="1180" height="27" as="geometry" /></mxCell><mxCell id="storage" value="STORAGE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="480" height="590" as="geometry" /></mxCell><mxCell id="pathfind" value="PATHFIND" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="610" y="840" width="1280" height="590" as="geometry" /></mxCell><mxCell id="deposit" value="DEPOSIT  (stub)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;dashed=1;dashPattern=6 3;" vertex="1" parent="storage"><mxGeometry x="40" y="50" width="400" height="80" as="geometry" /></mxCell><mxCell id="deposit_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// stub: deposit-location sensing&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;//&amp;nbsp;&amp;nbsp;&amp;nbsp;is not built yet&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="deposit"><mxGeometry y="26" width="400" height="54" as="geometry" /></mxCell><mxCell id="drive_in" value="DRIVE_IN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="40" y="230" width="400" height="94" as="geometry" /></mxCell><mxCell id="drive_in_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive_Distance_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.distance, 1000)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// through the Entrance&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive_Distance(kobuki.distance)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="drive_in"><mxGeometry y="26" width="400" height="68" as="geometry" /></mxCell><mxCell id="turn" value="TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="40" y="410" width="400" height="94" as="geometry" /></mxCell><mxCell id="turn_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: +135, B: -135)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// A: ACW, B: CW&amp;nbsp;&amp;nbsp;(face the Entrance)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="turn"><mxGeometry y="26" width="400" height="68" as="geometry" /></mxCell><mxCell id="storage_note" value="Bumper and cliff are ignored in TURN (the turn is made beside the ledge). DRIVE_IN ignores the cliff; any bumper ends it in DEPOSIT." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="storage"><mxGeometry x="20" y="522" width="440" height="50" as="geometry" /></mxCell><mxCell id="p_drive" value="DRIVE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="780" y="60" width="340" height="67" as="geometry" /></mxCell><mxCell id="p_drive_body" value="&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive(100)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// below the speed limit of 150&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_drive"><mxGeometry y="26" width="340" height="41" as="geometry" /></mxCell><mxCell id="p_reverse" value="REVERSE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="780" y="260" width="340" height="94" as="geometry" /></mxCell><mxCell id="p_reverse_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive_Distance_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.distance, -50)&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive_Distance(kobuki.distance)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// bumper and cliff are ignored here&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_reverse"><mxGeometry y="26" width="340" height="68" as="geometry" /></mxCell><mxCell id="p_rotate" value="ROTATE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="780" y="450" width="340" height="108" as="geometry" /></mxCell><mxCell id="p_rotate_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: +10, B: -10)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// fixed nudge, ignores heading&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// bumper and cliff are ignored here&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_rotate"><mxGeometry y="26" width="340" height="82" as="geometry" /></mxCell><mxCell id="p_cturn" value="CORRIDOR_TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="290" y="250" width="340" height="108" as="geometry" /></mxCell><mxCell id="p_cturn_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: +90, B: -90)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// A: ACW, B: CW&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;&lt;b&gt;exit /&lt;/b&gt; heading = kobuki.angle" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_cturn"><mxGeometry y="26" width="340" height="82" as="geometry" /></mxCell><mxCell id="p_cstop" value="CORRIDOR_STOP" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="30" y="435" width="210" height="53" as="geometry" /></mxCell><mxCell id="p_cstop_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_cstop"><mxGeometry y="26" width="210" height="27" as="geometry" /></mxCell><mxCell id="p_choice" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1150" y="906" width="28" height="28" as="geometry" /></mxCell><mxCell id="pathfind_note" value="One sub-FSM, run twice: corridor = 1 (ends in CORRIDOR_TURN), then corridor = 2 (ends in CORRIDOR_STOP). DRIVE checks, in order: 1 corridor length, 2 storage-wall bumper, 3 ledge cliff. Ignored in DRIVE: centre cliff, ledge-side bumper, storage-wall-side cliff, centre bumper. Corridor length is net travel from corridor_start_distance, so REVERSE counts against it. A wall bumper and a ledge cliff both run REVERSE, then ROTATE, then DRIVE (no forward resume)." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="pathfind"><mxGeometry x="30" y="505" width="740" height="75" as="geometry" /></mxCell><mxCell id="e_turn_drivein" value="kobuki.rotation_complete" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="turn" target="drive_in"><mxGeometry relative="1" as="geometry"><mxPoint x="75.0" y="0.0" as="offset" /></mxGeometry></mxCell><mxCell id="e_drivein_deposit_bump" value="1: any kobuki.bumper bit&lt;br&gt;/ Kobuki_Drive(STOP)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.1250;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1250;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="drive_in" target="deposit"><mxGeometry relative="1" as="geometry"><mxPoint x="80.0" y="0.0" as="offset" /></mxGeometry></mxCell><mxCell id="e_drivein_deposit_done" value="2: kobuki.&lt;br&gt;distance_complete" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.8500;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8500;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="drive_in" target="deposit"><mxGeometry relative="1" as="geometry"><mxPoint x="-58.0" y="0.0" as="offset" /></mxGeometry></mxCell><mxCell id="p_drive_reverse" value="&lt;div style=&quot;text-align:left&quot;&gt;2: storage wall bumper&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[A: kobuki.bumper &amp;amp; 0x01, B: kobuki.bumper &amp;amp; 0x04]&lt;br&gt;3: ledge cliff&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[A: kobuki.cliff &amp;amp; 0x04, B: kobuki.cliff &amp;amp; 0x01]&lt;/div&gt;" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.8529;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8529;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p_drive" target="p_reverse"><mxGeometry relative="1" as="geometry"><mxPoint x="-160.0" y="0.0" as="offset" /></mxGeometry></mxCell><mxCell id="p_reverse_rotate" value="kobuki.distance_complete" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p_reverse" target="p_rotate"><mxGeometry relative="1" as="geometry"><mxPoint x="78.0" y="0.0" as="offset" /></mxGeometry></mxCell><mxCell id="p_rotate_drive" value="kobuki.&lt;br&gt;rotation_&lt;br&gt;complete" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=1.0000;exitY=0.2778;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.2985;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p_rotate" target="p_drive"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1770" y="1320" /><mxPoint x="1770" y="920" /></Array><mxPoint x="45.0" y="5.0" as="offset" /></mxGeometry></mxCell><mxCell id="p_drive_choice" value="1: corridor length&lt;br&gt;[net travel &amp;gt;= 1200 mm]" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.0000;exitY=0.2985;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;e