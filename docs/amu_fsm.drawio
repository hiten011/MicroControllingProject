<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.5"><diagram id="amu_fsm" name="AMU FSM"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2190" pageHeight="945" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s_idle" value="IDLE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="400" height="185" as="geometry"/></mxCell><mxCell id="s_idle_body" value="Kobuki_Drive(STOP)&lt;br&gt;Wait for B0:&lt;br&gt;&amp;nbsp;&amp;nbsp;kobuki.button == BUTTON_0_START" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_idle"><mxGeometry y="26" width="400" height="159" as="geometry"/></mxCell><mxCell id="s_search" value="SEARCH" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="610" y="40" width="400" height="185" as="geometry"/></mxCell><mxCell id="s_search_body" value="Kobuki_Rotate(SEARCH_SPEED)      // spin on the spot&lt;br&gt;Ultrasonic_Detect(&amp;amp;object)       // every loop&lt;br&gt;&amp;nbsp;&amp;nbsp;object.detected when&lt;br&gt;&amp;nbsp;&amp;nbsp;object.range_mm &amp;lt; ULTRASONIC_DETECT_RANGE_MM&lt;br&gt;Sweep limit: 360° of kobuki.angle&lt;br&gt;None found after 360° -&amp;gt; sweep again" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_search"><mxGeometry y="26" width="400" height="159" as="geometry"/></mxCell><mxCell id="s_align" value="ALIGN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1180" y="40" width="400" height="185" as="geometry"/></mxCell><mxCell id="s_orient" value="ORIENT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1750" y="40" width="400" height="185" as="geometry"/></mxCell><mxCell id="s_orient_body" value="Layout from the bollard found in SEARCH&lt;br&gt;(A1 is far, B1 is near):&lt;br&gt;&amp;nbsp;&amp;nbsp;object.range_mm &amp;gt;  LAYOUT_RANGE_MM -&amp;gt; Layout A&lt;br&gt;&amp;nbsp;&amp;nbsp;object.range_mm &amp;lt;= LAYOUT_RANGE_MM -&amp;gt; Layout B&lt;br&gt;A: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -90)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// CW 90: now facing the bottom corridor&lt;br&gt;B: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +90)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// ACW 90: now facing the left corridor&lt;br&gt;Each loop: Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_orient"><mxGeometry y="26" width="400" height="159" as="geometry"/></mxCell><mxCell id="s_pf1" value="PATHFIND 1" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1750" y="465" width="400" height="290" as="geometry"/></mxCell><mxCell id="s_pf1_body" value="Kobuki_Drive(PATH_SPEED)         // below SPEED_LIMIT&lt;br&gt;Hit the wall -&amp;gt; turn away from it:&lt;br&gt;&amp;nbsp;&amp;nbsp;A: if kobuki.bumper &amp;amp; BUMPER_LEFT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -WALL_DEG)&lt;br&gt;&amp;nbsp;&amp;nbsp;B: if kobuki.bumper &amp;amp; BUMPER_RIGHT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +WALL_DEG)&lt;br&gt;Near the ledge -&amp;gt; re-centre:&lt;br&gt;&amp;nbsp;&amp;nbsp;A: if kobuki.cliff &amp;amp; CLIFF_RIGHT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +LEDGE_DEG)&lt;br&gt;&amp;nbsp;&amp;nbsp;B: if kobuki.cliff &amp;amp; CLIFF_LEFT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -LEDGE_DEG)&lt;br&gt;Front cliff (kobuki.cliff &amp;amp; CLIFF_CENTRE):&lt;br&gt;&amp;nbsp;&amp;nbsp;A: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +90)   // ACW&lt;br&gt;&amp;nbsp;&amp;nbsp;B: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -90)   // CW&lt;br&gt;Each loop: Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_pf1"><mxGeometry y="26" width="400" height="264" as="geometry"/></mxCell><mxCell id="s_pf2" value="PATHFIND 2" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1180" y="465" width="400" height="290" as="geometry"/></mxCell><mxCell id="s_pf2_body" value="Kobuki_Drive(PATH_SPEED)         // below SPEED_LIMIT&lt;br&gt;Same wall / ledge corrections as PATHFIND 1&lt;br&gt;&amp;nbsp;&amp;nbsp;(A: wall on the left, ledge on the right&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;B: wall on the right, ledge on the left)&lt;br&gt;Front cliff (kobuki.cliff &amp;amp; CLIFF_CENTRE):&lt;br&gt;&amp;nbsp;&amp;nbsp;Kobuki_Drive(STOP)&lt;br&gt;&amp;nbsp;&amp;nbsp;the turn into the unit is made in STORAGE" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_pf2"><mxGeometry y="26" width="400" height="264" as="geometry"/></mxCell><mxCell id="s_storage" value="STORAGE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="610" y="465" width="400" height="205" as="geometry"/></mxCell><mxCell id="s_storage_body" value="Face the entrance (diagonal opening):&lt;br&gt;&amp;nbsp;&amp;nbsp;A: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +135)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// ACW 135&lt;br&gt;&amp;nbsp;&amp;nbsp;B: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -135)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// CW 135&lt;br&gt;&amp;nbsp;&amp;nbsp;Each loop: Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;When kobuki.rotation_complete, drive in:&lt;br&gt;&amp;nbsp;&amp;nbsp;Kobuki_Drive_Distance_Setpoint(kobuki.distance, ENTRY_MM)&lt;br&gt;&amp;nbsp;&amp;nbsp;Each loop: Kobuki_Drive_Distance(kobuki.distance)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_storage"><mxGeometry y="26" width="400" height="179" as="geometry"/></mxCell><mxCell id="s_deposit" value="DEPOSIT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="400" height="205" as="geometry"/></mxCell><mxCell id="s_stop" value="STOP (B1 / wheel drop)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="915" y="280" width="360" height="130" as="geometry"/></mxCell><mxCell id="s_stop_body" value="Kobuki_Drive(STOP)&lt;br&gt;Entered from any state when:&lt;br&gt;&amp;nbsp;&amp;nbsp;kobuki.button == BUTTON_1_STOP (B1)&lt;br&gt;&amp;nbsp;&amp;nbsp;kobuki.wheeldrop != 0" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_stop"><mxGeometry y="26" width="360" height="104" as="geometry"/></mxCell><mxCell id="e1" value="B0&lt;br&gt;BUTTON_0_START" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.3243;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3243;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_idle" target="s_search"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="object.detected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.3243;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3243;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_search" target="s_align"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="align_done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.3243;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3243;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_align" target="s_orient"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="e4" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_orient" target="s_pf1"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="92" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="front cliff, then&lt;br&gt;90° turn done&lt;br&gt;(kobuki.rotation_complete)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.2414;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.2414;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pf1" target="s_pf2"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-34" as="offset"/></mxGeometry></mxCell><mxCell id="e6" value="front cliff&lt;br&gt;(CLIFF_CENTRE)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.2414;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3415;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pf2" target="s_storage"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="e7" value="storage_complete&lt;br&gt;(kobuki.distance_complete)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.3415;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3415;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_storage" target="s_deposit"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="e8" value="deposit_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1500;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.1500;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_deposit" target="s_idle"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="62" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e9" value="B1 | wheeldrop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.8500;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0972;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_search" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="-58" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e10" value="B1 | wheeldrop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1500;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.9028;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_align" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="58" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e11" value="B1 | wheeldrop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.8500;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.0972;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_storage" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="-58" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e12" value="B1 | wheeldrop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1500;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.9028;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pf2" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="58" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e13" value="B1 | wheeldrop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1500;exitY=1.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_orient" target="s_stop"><mxGeometry relative="1" x="0.35" as="geometry"><Array as="points"><mxPoint x="1810" y="345.0"/></Array><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1500;exitY=0.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pf1" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><Array as="points"><mxPoint x="1810" y="345.0"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e15" value="B1 | wheeldrop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.8000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.7692;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_deposit" target="s_stop"><mxGeometry relative="1" x="-0.3" as="geometry"><Array as="points"><mxPoint x="360" y="380"/></Array><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e16" value="return to IDLE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.1923;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.8000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_stop" target="s_idle"><mxGeometry relative="1" x="-0.2" as="geometry"><Array as="points"><mxPoint x="525" y="305"/><mxPoint x="525" y="188.0"/></Array><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="note" value="Conventions&lt;br&gt;Angles are in degrees: + = ACW (left), - = CW (right)  (Kobuki_Rotate: +ve is CCW).&lt;br&gt;Layout A: bollards A1/A2 block the left/top route, so the robot takes the bottom corridor, then the right corridor.&lt;br&gt;Layout B: bollards B1/B2 block the bottom/right route, so the robot takes the left corridor, then the top corridor.&lt;br&gt;Bumper / cliff bits (Kobuki protocol): right = 0x01, centre = 0x02, left = 0x04.&lt;br&gt;New #defines needed: BUMPER_*, CLIFF_*, PATH_SPEED, WALL_DEG, LEDGE_DEG, LAYOUT_RANGE_MM, ENTRY_MM." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="805" width="1300" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>