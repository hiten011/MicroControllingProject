<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.5"><diagram id="amu_fsm" name="AMU FSM"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s_idle" value="IDLE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="470" height="284" as="geometry"/></mxCell><mxCell id="s_idle_body" value="do / Kobuki_Drive(STOP)&lt;br&gt;exit / layout = none&lt;br&gt;&amp;nbsp;&amp;nbsp;object.detected = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;swept_deg = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;sweep_count = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;last_angle = kobuki.angle&lt;br&gt;&amp;nbsp;&amp;nbsp;// SEARCH starts clean. It cannot reset itself: DETECT and SPIN re-enter it." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_idle"><mxGeometry y="26" width="470" height="258" as="geometry"/></mxCell><mxCell id="s_search" value="SEARCH" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="660" y="40" width="470" height="284" as="geometry"/></mxCell><mxCell id="s_search_body" value="do / if object.detected:        // range_mm is object.range_mm&lt;br&gt;&amp;nbsp;&amp;nbsp;if LAYOUT_RANGE_MM (450) &amp;lt; range_mm &amp;lt;= LAYOUT_MAX_RANGE_MM (650):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;layout = A                   // far bollard&lt;br&gt;&amp;nbsp;&amp;nbsp;else if LAYOUT_MIN_RANGE_MM (300) &amp;lt;= range_mm&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;and range_mm &amp;lt;= LAYOUT_RANGE_MM (450):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;layout = B                   // near bollard&lt;br&gt;&amp;nbsp;&amp;nbsp;else:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;layout = none&lt;br&gt;&amp;nbsp;&amp;nbsp;// deduced from this reading, saved (overwritten at every Detection)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_search"><mxGeometry y="26" width="470" height="258" as="geometry"/></mxCell><mxCell id="s_align" value="ALIGN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1280" y="40" width="470" height="284" as="geometry"/></mxCell><mxCell id="s_align_body" value="Turn from the first-detection heading to the centre heading:&lt;br&gt;&amp;nbsp;&amp;nbsp;Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +ALIGN_OFFSET_DEG)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// ACW, the way SEARCH was spinning. Same offset in both layouts.&lt;br&gt;Setpoint once on entry. Each loop: Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;kobuki.rotation_complete (tested from the next loop) -&amp;gt; ORIENT&lt;br&gt;Any kobuki.bumper bit -&amp;gt; STOP / FAULT. kobuki.cliff is ignored.&lt;br&gt;No sensor read here, and no way back to SEARCH.&lt;br&gt;Setting ALIGN_OFFSET_DEG (placeholder until measured on the hardware):&lt;br&gt;&amp;nbsp;&amp;nbsp;At least 8 random start headings per layout: run SEARCH to its stop,&lt;br&gt;&amp;nbsp;&amp;nbsp;jog to the bollard centre, record the turn.&lt;br&gt;&amp;nbsp;&amp;nbsp;Median = the offset. Spread = the accuracy ALIGN will have.&lt;br&gt;&amp;nbsp;&amp;nbsp;Layout medians differ by more than the spread -&amp;gt; one offset per layout.&lt;br&gt;&amp;nbsp;&amp;nbsp;Spread too big -&amp;gt; sweep ACW to the far edge, turn back half the span." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_align"><mxGeometry y="26" width="470" height="258" as="geometry"/></mxCell><mxCell id="s_orient" value="ORIENT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1900" y="40" width="470" height="284" as="geometry"/></mxCell><mxCell id="s_orient_body" value="entry / A: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -90)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// CW 90: now facing the bottom corridor&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;B: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +90)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// ACW 90: now facing the left corridor&lt;br&gt;do / Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;// A or B is the layout saved by SEARCH, never a live reading" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_orient"><mxGeometry y="26" width="470" height="258" as="geometry"/></mxCell><mxCell id="s_stop" value="STOP / FAULT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="925" y="684" width="560" height="209" as="geometry"/></mxCell><mxCell id="s_stop_body" value="do / Kobuki_Drive(STOP)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_stop"><mxGeometry y="26" width="560" height="183" as="geometry"/></mxCell><mxCell id="s_deposit" value="DEPOSIT (stub)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="973" width="470" height="179" as="geometry"/></mxCell><mxCell id="s_storage" value="STORAGE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="660" y="973" width="470" height="179" as="geometry"/></mxCell><mxCell id="s_storage_body" value="Sub-FSM: see the STORAGE tab&lt;br&gt;do / TURN, then DRIVE_IN" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_storage"><mxGeometry y="26" width="470" height="153" as="geometry"/></mxCell><mxCell id="s_pf2" value="PATHFIND 2" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1280" y="973" width="470" height="179" as="geometry"/></mxCell><mxCell id="s_pf2_body" value="Sub-FSM: see the PATHFIND tab (second corridor)&lt;br&gt;entry / heading = kobuki.angle     // corridor heading&lt;br&gt;do / Kobuki_Drive(PATH_SPEED (100))   // below SPEED_LIMIT (150)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;with the same wall and ledge corrections as PATHFIND 1&lt;br&gt;exit / Kobuki_Drive(STOP)            // at the front cliff" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_pf2"><mxGeometry y="26" width="470" height="153" as="geometry"/></mxCell><mxCell id="s_pf1" value="PATHFIND 1" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1900" y="973" width="470" height="179" as="geometry"/></mxCell><mxCell id="s_pf1_body" value="Sub-FSM: see the PATHFIND tab (first corridor)&lt;br&gt;entry / heading = kobuki.angle     // corridor heading&lt;br&gt;do / Kobuki_Drive(PATH_SPEED (100))   // below SPEED_LIMIT (150)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;with wall and ledge corrections (see the tab)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_pf1"><mxGeometry y="26" width="470" height="153" as="geometry"/></mxCell><mxCell id="e1" value="B0&lt;br&gt;[kobuki.button &amp;amp;&lt;br&gt;BUTTON_0_START (0x01)]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.2000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_idle" target="s_search"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-28" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="[object.detected,&lt;br&gt;layout = A or B]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.2000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_search" target="s_align"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="align done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.2000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_align" target="s_orient"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="e4" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_orient" target="s_pf1"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="92" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="front cliff, then&lt;br&gt;+90 (A) / -90 (B) turn done&lt;br&gt;(kobuki.rotation_complete)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.3000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pf1" target="s_pf2"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="e6" value="front cliff (CLIFF_CENTRE),&lt;br&gt;stopped" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.3000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pf2" target="s_storage"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-26" as="offset"/></mxGeometry></mxCell><mxCell id="e7" value="kobuki.distance_complete&lt;br&gt;or any kobuki.bumper bit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.3000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_storage" target="s_deposit"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-26" as="offset"/></mxGeometry></mxCell><mxCell id="e8" value="deposit complete (stub: at once)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1500;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.1500;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_deposit" target="s_idle"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="62" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e9" value="B1 | wheeldrop | bumper | cliff&lt;br&gt;[object.detected, layout = none]&lt;br&gt;[sweep_count == MAX_SEARCH_SWEEPS (2)]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.7500;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2010;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_search" target="s_stop"><mxGeometry relative="1" x="0.62" as="geometry"><Array as="points"><mxPoint x="600" y="253"/><mxPoint x="600" y="726"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e10" value="B1 | wheeldrop | bumper" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.9468;exitY=1.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.1196;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_align" target="s_stop"><mxGeometry relative="1" x="0.55" as="geometry"><Array as="points"><mxPoint x="1725" y="709"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e11" value="B1 | wheeldrop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.8500;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.2402;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_storage" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="-50" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e12" value="B1 | wheeldrop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1500;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.7598;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pf2" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="50" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e13" value="B1 | wheeldrop | bumper | cliff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1200;exitY=1.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_orient" target="s_stop"><mxGeometry relative="1" x="0.55" as="geometry"><Array as="points"><mxPoint x="1956" y="747"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e14" value="B1 | wheeldrop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.2500;exitY=0.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.7500;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pf1" target="s_stop"><mxGeometry relative="1" x="0.55" as="geometry"><Array as="points"><mxPoint x="2018" y="841"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e15" value="B1 | wheeldrop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.8000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.7500;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_deposit" target="s_stop"><mxGeometry relative="1" x="-0.55" as="geometry"><Array as="points"><mxPoint x="416" y="841"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e16" value="ε" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.4498;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.8000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_stop" target="s_idle"><mxGeometry relative="1" x="-0.45" as="geometry"><Array as="points"><mxPoint x="545" y="778"/><mxPoint x="545" y="267"/></Array><mxPoint x="0" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="note" value="Conventions&lt;br&gt;Boxes list actions only: entry / (once, on entering the state), do / (every loop), exit / (once, on leaving it). Every trigger and [guard] is on an edge.&lt;br&gt;A transition labelled ε has no trigger: it is taken at the next loop step, so each state still takes one Kobuki packet.&lt;br&gt;Angles are in degrees: + = ACW (left), - = CW (right)  (Kobuki_Rotate: +ve is CCW).&lt;br&gt;Layout A: bollards A1/A2 block the left/top route, so the AMU takes the bottom corridor, then the right corridor.&lt;br&gt;Layout B: bollards B1/B2 block the bottom/right route, so the AMU takes the left corridor, then the top corridor.&lt;br&gt;Layout A has the storage wall on the left and the ledge on the right. Layout B is the mirror image.&lt;br&gt;Bumper / cliff bits (Kobuki protocol): right = 0x01, centre = 0x02, left = 0x04.&lt;br&gt;B1 = kobuki.button &amp;amp; BUTTON_1_STOP (0x02). wheeldrop = kobuki.wheeldrop != 0. Both have a red edge to STOP / FAULT from every state except IDLE.&lt;br&gt;Bumper and cliff are expected in PATHFIND and STORAGE, so they are not faults there. There are no timeouts.&lt;br&gt;One FSM step per received Kobuki packet. Sensors are read at the top of the loop (Kobuki_Read).&lt;br&gt;Motion setpoints (Kobuki_Rotate_Angle_Setpoint, Kobuki_Drive_Distance_Setpoint) are one-shot entry actions.&lt;br&gt;Completion flags (kobuki.rotation_complete, kobuki.distance_complete) are a snapshot from the top of the loop, so they are tested from the next loop.&lt;br&gt;Drive and rotate commands are never issued in the same loop.&lt;br&gt;A number in brackets after a name is its current value (Src/AMU/amu_config.h, ultrasonic.h, kobuki.h). PATH_SPEED, WALL_DEG, LEDGE_DEG, ALIGN_OFFSET_DEG, the three LAYOUT ranges and ENTRY_MM are placeholders until measured on the hardware.&lt;br&gt;SEARCH_STEP_DEG has no value yet.&lt;br&gt;New names (Src/AMU/amu_config.h, amu_helpers.h): BUTTON_0_START, BUTTON_1_STOP, BUMPER_RIGHT, BUMPER_CENTRE, BUMPER_LEFT, CLIFF_RIGHT, CLIFF_CENTRE, CLIFF_LEFT,&lt;br&gt;&amp;nbsp;&amp;nbsp;PATH_SPEED, WALL_DEG, LEDGE_DEG, LAYOUT_MIN_RANGE_MM, LAYOUT_RANGE_MM, LAYOUT_MAX_RANGE_MM, ENTRY_MM, MAX_SEARCH_SWEEPS, SEARCH_STEP_DEG, ALIGN_OFFSET_DEG, AMU_Angle_Delta_Deg(), AMU_Layout_From_Range().&lt;br&gt;&amp;nbsp;&amp;nbsp;AMU_Layout_From_Range() and AMU_Angle_Delta_Deg() hold the logic that SEARCH, SPIN and REALIGN write out." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1202" width="2300" height="310" as="geometry"/></mxCell><mxCell id="s_detect" value="DETECT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="660" y="404" width="470" height="230" as="geometry"/></mxCell><mxCell id="s_detect_body" value="do / Kobuki_Drive(STOP)                  // hold still&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Ultrasonic_Detect(&amp;amp;object):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.range_mm = ultrasonic reading&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.detected =&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(range_mm &amp;lt; ULTRASONIC_DETECT_RANGE_MM (700))" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_detect"><mxGeometry y="26" width="470" height="204" as="geometry"/></mxCell><mxCell id="s_spin" value="SPIN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1280" y="404" width="410" height="230" as="geometry"/></mxCell><mxCell id="s_spin_body" value="entry / Kobuki_Rotate_Angle_Setpoint(kobuki.angle,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;SEARCH_STEP_DEG)             // one Step, ACW&lt;br&gt;do / Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;exit / swept_deg += shortest signed angle from&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;last_angle to kobuki.angle   // + = ACW, wraps at +/-180&lt;br&gt;&amp;nbsp;&amp;nbsp;last_angle = kobuki.angle&lt;br&gt;&amp;nbsp;&amp;nbsp;if swept_deg &amp;gt;= 360:           // one full Sweep&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;swept_deg -= 360&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sweep_count++" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_spin"><mxGeometry y="26" width="410" height="204" as="geometry"/></mxCell><mxCell id="e17" value="ε&lt;br&gt;[object.detected = 0,&lt;br&gt;sweep_count &amp;lt; MAX_SEARCH_SWEEPS (2)]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.4000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.4000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_search" target="s_detect"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="-103" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e18" value="[object.detected]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.7000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.7000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_detect" target="s_search"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="-55" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e19" value="[nothing detected]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.4500;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.4500;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_detect" target="s_spin"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e20" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.9000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_spin" target="s_search"><mxGeometry relative="1" x="0.0" as="geometry"><Array as="points"><mxPoint x="1321" y="364"/><mxPoint x="1083" y="364"/></Array><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="e21" value="B1 | wheeldrop | bumper | cliff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.7234;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.1339;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_detect" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="-90" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e22" value="B1 | wheeldrop | bumper | cliff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.2927;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8482;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_spin" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="90" y="0" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="amu_fsm_pathfind" name="PATHFIND"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="One shared sub-FSM, used for the first and the second corridor and parameterised by the saved layout (A: storage wall on the left, ledge on the right. B: the mirror image)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2100" height="27.0" as="geometry"/></mxCell><mxCell id="entry" value="entry / heading = kobuki.angle&lt;br&gt;(first corridor: from ORIENT,&lt;br&gt;second corridor: from this exit)" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="90" as="geometry"/></mxCell><mxCell id="p_drive" value="DRIVE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="560" height="224" as="geometry"/></mxCell><mxCell id="p_drive_body" value="do / Kobuki_Drive(PATH_SPEED (100))     // below SPEED_LIMIT (150)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_drive"><mxGeometry y="26" width="560" height="198" as="geometry"/></mxCell><mxCell id="p_wall" value="WALL_HIT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1420" y="60" width="580" height="104.0" as="geometry"/></mxCell><mxCell id="p_wall_body" value="entry / A: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -WALL_DEG (10))   // CW&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;B: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +WALL_DEG (10))   // ACW&lt;br&gt;do / Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_wall"><mxGeometry y="26" width="580" height="78.0" as="geometry"/></mxCell><mxCell id="p_ledge" value="LEDGE_HIT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1420" y="400" width="580" height="104.0" as="geometry"/></mxCell><mxCell id="p_ledge_body" value="entry / A: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +LEDGE_DEG (10))  // ACW&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;B: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -LEDGE_DEG (10))  // CW&lt;br&gt;do / Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_ledge"><mxGeometry y="26" width="580" height="78.0" as="geometry"/></mxCell><mxCell id="p_realign" value="REALIGN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1420" y="740" width="580" height="119.0" as="geometry"/></mxCell><mxCell id="p_realign_body" value="entry / Kobuki_Rotate_Angle_Setpoint(kobuki.angle,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;shortest signed angle from kobuki.angle to heading)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// back to the corridor heading. + = ACW, wraps at +/-180&lt;br&gt;do / Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_realign"><mxGeometry y="26" width="580" height="93.0" as="geometry"/></mxCell><mxCell id="p_fct" value="FRONT_CLIFF_TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="460" width="560" height="194" as="geometry"/></mxCell><mxCell id="p_fct_body" value="First corridor:&lt;br&gt;&amp;nbsp;&amp;nbsp;entry / A: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +90)   // ACW&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;B: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -90)   // CW&lt;br&gt;&amp;nbsp;&amp;nbsp;do / Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;&amp;nbsp;&amp;nbsp;exit / heading = kobuki.angle        // re-latch the heading&lt;br&gt;Second corridor:&lt;br&gt;&amp;nbsp;&amp;nbsp;entry / Kobuki_Drive(STOP)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_fct"><mxGeometry y="26" width="560" height="168" as="geometry"/></mxCell><mxCell id="x_pf2" value="to PATHFIND 2&lt;br&gt;(first corridor)" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="200" height="50" as="geometry"/></mxCell><mxCell id="x_st" value="to STORAGE&lt;br&gt;(second corridor)" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="200" height="50" as="geometry"/></mxCell><mxCell id="p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.1500;entryDx=0;entryDy=0;" edge="1" parent="1" source="entry" target="p_drive"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p2" value="2: storage wall bumper&lt;br&gt;[A: kobuki.bumper &amp;amp; BUMPER_LEFT (0x04)&lt;br&gt;B: kobuki.bumper &amp;amp; BUMPER_RIGHT (0x01)]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.1200;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3500;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_drive" target="p_wall"><mxGeometry relative="1" x="-0.5" as="geometry"><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="p3" value="3: ledge cliff&lt;br&gt;[A: kobuki.cliff &amp;amp; CLIFF_RIGHT (0x01)&lt;br&gt;B: kobuki.cliff &amp;amp; CLIFF_LEFT (0x04)]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.7500;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3500;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_drive" target="p_ledge"><mxGeometry relative="1" x="-0.5" as="geometry"><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="p4" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_wall" target="p_realign"><mxGeometry relative="1" x="0.2" as="geometry"><Array as="points"><mxPoint x="2060" y="112"/><mxPoint x="2060" y="776"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p5" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_ledge" target="p_realign"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="70" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p6" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.2000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.9200;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_realign" target="p_drive"><mxGeometry relative="1" x="0.1" as="geometry"><Array as="points"><mxPoint x="1010" y="764"/><mxPoint x="1010" y="296"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p7" value="1: front cliff&lt;br&gt;[kobuki.cliff &amp;amp; CLIFF_CENTRE (0x02)]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_drive" target="p_fct"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="110" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p8" value="[first corridor]&lt;br&gt;kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.3000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_fct" target="x_pf2"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="p9" value="[second corridor]&lt;br&gt;ε" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.7500;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_fct" target="x_st"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="foot" value="Every sub-state: B1 or wheeldrop -&amp;gt; STOP / FAULT (main tab). There are no other faults in PATHFIND.&lt;br&gt;DRIVE triggers are checked in the order 1, 2, 3. Ignored in DRIVE: bumper on the ledge side, cliff on the storage wall side, BUMPER_CENTRE.&lt;br&gt;Drive and rotate commands are never issued in the same loop. Setpoints are one-shot entry actions. kobuki.rotation_complete is tested from the next loop.&lt;br&gt;No reverse (back-off) after the front cliff: a hardware experiment only." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="420" y="1000" width="1300" height="75" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="amu_fsm_storage" name="STORAGE"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Sub-FSM of STORAGE (A: turn +135, B: turn -135). Entered from PATHFIND 2, stopped at the front cliff." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="27.0" as="geometry"/></mxCell><mxCell id="entry" value="enter STORAGE&lt;br&gt;(stopped)" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="60" as="geometry"/></mxCell><mxCell id="t_turn" value="TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="560" height="134" as="geometry"/></mxCell><mxCell id="t_turn_body" value="entry / A: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +135)   // ACW&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;B: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -135)   // CW&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// face the entrance (diagonal opening)&lt;br&gt;do / Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="t_turn"><mxGeometry y="26" width="560" height="108" as="geometry"/></mxCell><mxCell id="t_drive" value="DRIVE_IN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1060" y="80" width="560" height="134" as="geometry"/></mxCell><mxCell id="t_drive_body" value="entry / Kobuki_Drive_Distance_Setpoint(kobuki.distance, ENTRY_MM (740))&lt;br&gt;do / Kobuki_Drive_Distance(kobuki.distance)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="t_drive"><mxGeometry y="26" width="560" height="108" as="geometry"/></mxCell><mxCell id="x_dep" value="to DEPOSIT" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1260" y="330" width="200" height="50" as="geometry"/></mxCell><mxCell id="t1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.1500;entryDx=0;entryDy=0;" edge="1" parent="1" source="entry" target="t_turn"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="t2" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.2000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_turn" target="t_drive"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="t3" value="kobuki.distance_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.3000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_drive" target="x_dep"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="-80" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="t4" value="any kobuki.bumper bit&lt;br&gt;/ Kobuki_Drive(STOP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.7000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.7000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_drive" target="x_dep"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="80" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="foot" value="Every sub-state: B1 or wheeldrop -&amp;gt; STOP / FAULT (main tab). There are no other faults in STORAGE.&lt;br&gt;Ignored in TURN: kobuki.bumper and kobuki.cliff (the turn is made beside the ledge). Ignored in DRIVE_IN: kobuki.cliff.&lt;br&gt;Setpoints are one-shot entry actions. kobuki.rotation_complete and kobuki.distance_complete are tested from the next loop." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="340" y="430" width="1300" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>