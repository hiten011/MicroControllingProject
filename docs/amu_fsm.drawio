<mxfile host="app.diagrams.net" agent="hiten" version="24.7.5"><diagram id="amu_fsm" name="AMU FSM"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1930" pageHeight="2356" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;AMU parcel-run FSM&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=20;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="subtitle" value="One box per State in the Src/main.c switch (the DEPOSIT phase is designed but not in the firmware yet). UML state-machine notation: trigger [guard] / effect. Terms follow GLOSSARY.md. A / B is the Layout learned by IDENTIFY." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1700" height="18" as="geometry" /></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="132" y="264" width="16" height="16" as="geometry" /></mxCell><mxCell id="idle" value="IDLE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="230" height="136" as="geometry" /></mxCell><mxCell id="idle_body" value="&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&lt;b&gt;exit /&lt;/b&gt; layout = none&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.detected = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;heading = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;corridor = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Scan_Start(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="idle"><mxGeometry x="0" y="26" width="230" height="110" as="geometry" /></mxCell><mxCell id="search_phase" value="SEARCH (phase)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="380" y="96" width="1060" height="320" as="geometry" /></mxCell><mxCell id="identify" value="IDENTIFY" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="search_phase"><mxGeometry x="680" y="213" width="340" height="81" as="geometry" /></mxCell><mxCell id="identify_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// then layout =&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;//   Layout_From_Range(object.range_mm)&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="identify"><mxGeometry x="0" y="26" width="340" height="55" as="geometry" /></mxCell><mxCell id="search" value="SEARCH" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="search_phase"><mxGeometry x="40" y="213" width="250" height="81" as="geometry" /></mxCell><mxCell id="search_body" value="&lt;b&gt;do /&lt;/b&gt; Scan_Sample()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(+150)  &lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// ACW&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// until something is near&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="search"><mxGeometry x="0" y="26" width="250" height="55" as="geometry" /></mxCell><mxCell id="search_phase_note" value="&lt;b&gt;Search phase&lt;/b&gt;&lt;br&gt;The AMU turns anticlockwise on the spot from B0 and reads the ultrasonic once per Tick (Scan_Sample() = Scan_Update_Turn(kobuki.angle) + Ultrasonic_Detect(&amp;object); object.detected = range_mm &lt; 750). &lt;b&gt;scan_deg&lt;/b&gt; is the net turn since the last Scan_Start() (B0 here, DEPOSIT_SEARCH later) in degrees, ACW positive, summed from gyro changes so it does not wrap at 180; SEARCH uses it only for the give-up, DEPOSIT for the edges and the Centre heading.&lt;br&gt;&lt;br&gt;&lt;b&gt;Give up&lt;/b&gt; (Scan_Gave_Up(): LED1 green, then STOP / FAULT): SEARCH when scan_deg &gt;= 360.&lt;br&gt;&lt;br&gt;&lt;b&gt;Identify&lt;/b&gt;: on the first Detection the AMU stops, then layout = Layout_From_Range(object.range_mm), which is B when range_mm &lt; 575, otherwise A. LED1 red for A, yellow for B. There is no centring: ORIENT turns from wherever SEARCH stopped." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="search_phase"><mxGeometry x="20" y="44" width="1020" height="160" as="geometry" /></mxCell><mxCell id="orient" value="ORIENT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1600" y="294" width="320" height="111" as="geometry" /></mxCell><mxCell id="orient_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: -75, B: +103)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// A: CW, B: ACW  (from where&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;//   SEARCH stopped)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="orient"><mxGeometry x="0" y="26" width="320" height="85" as="geometry" /></mxCell><mxCell id="fault" value="STOP / FAULT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;swimlaneFillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="380" y="510" width="1180" height="53" as="geometry" /></mxCell><mxCell id="fault_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="fault"><mxGeometry y="26" width="1180" height="27" as="geometry" /></mxCell><mxCell id="storage" value="STORAGE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="480" height="590" as="geometry" /></mxCell><mxCell id="pathfind" value="PATHFIND" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="610" y="670" width="1280" height="590" as="geometry" /></mxCell><mxCell id="drive_in" value="DRIVE_IN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="40" y="320" width="400" height="94" as="geometry" /></mxCell><mxCell id="drive_in_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive_Distance_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.distance, 900)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// through the Entrance&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive_Distance(kobuki.distance)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="drive_in"><mxGeometry y="26" width="400" height="68" as="geometry" /></mxCell><mxCell id="turn" value="TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="storage"><mxGeometry x="40" y="140" width="400" height="94" as="geometry" /></mxCell><mxCell id="turn_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: +135, B: -135)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// A: ACW, B: CW&amp;nbsp;&amp;nbsp;(face the Entrance)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="turn"><mxGeometry y="26" width="400" height="68" as="geometry" /></mxCell><mxCell id="storage_note" value="Bumper and cliff are ignored in TURN (the turn is made beside the ledge). DRIVE_IN ignores the cliff; any bumper ends it. Either way DEPOSIT_SEARCH follows." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="storage"><mxGeometry x="20" y="44" width="440" height="50" as="geometry" /></mxCell><mxCell id="p_drive" value="DRIVE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="780" y="60" width="340" height="67" as="geometry" /></mxCell><mxCell id="p_drive_body" value="&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive(150)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// the speed limit (150 mm/s)&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_drive"><mxGeometry y="26" width="340" height="41" as="geometry" /></mxCell><mxCell id="p_reverse" value="REVERSE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="780" y="260" width="340" height="94" as="geometry" /></mxCell><mxCell id="p_reverse_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive_Distance_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.distance, -50)&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive_Distance(kobuki.distance)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// bumper and cliff are ignored here&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_reverse"><mxGeometry y="26" width="340" height="68" as="geometry" /></mxCell><mxCell id="p_rotate" value="ROTATE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="780" y="450" width="340" height="122" as="geometry" /></mxCell><mxCell id="p_rotate_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, pathfind_recover_deg)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// latched in DRIVE: wall A -5, B +5;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;//   ledge A +5, B -5; ignores heading&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// bumper and cliff are ignored here&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_rotate"><mxGeometry y="26" width="340" height="96" as="geometry" /></mxCell><mxCell id="p_cturn" value="CORRIDOR_TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="290" y="290" width="340" height="108" as="geometry" /></mxCell><mxCell id="p_cturn_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, A: +90, B: -90)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// A: ACW, B: CW&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;&lt;b&gt;exit /&lt;/b&gt; heading = kobuki.angle" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_cturn"><mxGeometry y="26" width="340" height="82" as="geometry" /></mxCell><mxCell id="p_cstop" value="CORRIDOR_STOP" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="30" y="435" width="210" height="53" as="geometry" /></mxCell><mxCell id="p_cstop_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_cstop"><mxGeometry y="26" width="210" height="27" as="geometry" /></mxCell><mxCell id="p_choice" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1150" y="736" width="28" height="28" as="geometry" /></mxCell><mxCell id="pathfind_note" value="One sub-FSM, run twice: corridor = 1 (ends in CORRIDOR_REVERSE, then CORRIDOR_TURN), then corridor = 2 (ends in CORRIDOR_STOP). A corridor ends on the front cliff, not on distance. DRIVE checks, in order: 1 front cliff, 2 storage-wall bumper, 3 ledge cliff. Ignored in DRIVE: ledge-side bumper, storage-wall-side cliff, centre bumper. A wall bumper and a ledge cliff both run REVERSE, then ROTATE, then DRIVE (no forward resume)." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="pathfind"><mxGeometry x="30" y="505" width="740" height="75" as="geometry" /></mxCell><mxCell id="p_crev" value="CORRIDOR_REVERSE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="pathfind"><mxGeometry x="290" y="146" width="340" height="94" as="geometry" /></mxCell><mxCell id="p_crev_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive_Distance_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.distance, -50)&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive_Distance(kobuki.distance)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// bumper and cliff are ignored here&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p_crev"><mxGeometry x="0" y="26" width="340" height="68" as="geometry" /></mxCell><mxCell id="dp_phase" value="DEPOSIT (phase)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=28;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=14;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="40" y="1310" width="1850" height="670" as="geometry" /></mxCell><mxCell id="dp_search" value="DEPOSIT_SEARCH" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="dp_phase"><mxGeometry x="20" y="60" width="330" height="108" as="geometry" /></mxCell><mxCell id="dp_search_body" value="&lt;b&gt;entry /&lt;/b&gt; Scan_Start(kobuki.angle)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;backoffs = 0&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Scan_Sample()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(+50)  &lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// ACW&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// until range_mm &amp;lt; 500&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="dp_search"><mxGeometry x="0" y="26" width="330" height="82" as="geometry" /></mxCell><mxCell id="dp_track" value="DEPOSIT_TRACK" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="dp_phase"><mxGeometry x="513" y="60" width="330" height="108" as="geometry" /></mxCell><mxCell id="dp_track_body" value="&lt;b&gt;do /&lt;/b&gt; Scan_Sample()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if range_mm &amp;lt; 500:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;last_seen = scan_deg&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;closest = min(closest, range_mm)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(+50)  &lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// ACW&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="dp_track"><mxGeometry x="0" y="26" width="330" height="82" as="geometry" /></mxCell><mxCell id="dp_edge" value="DEPOSIT_EDGE_SCAN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="dp_phase"><mxGeometry x="1006" y="60" width="330" height="150" as="geometry" /></mxCell><mxCell id="dp_edge_body" value="&lt;b&gt;entry /&lt;/b&gt; edge_mm = closest + 60&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;edge_start = +10000, edge_end = -10000&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Scan_Sample()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;closest = min(closest, range_mm)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if range_mm &amp;lt;= edge_mm:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;edge_start = min(edge_start, scan_deg)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;edge_end = max(edge_end, scan_deg)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(-50)  &lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// CW, back across&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="dp_edge"><mxGeometry x="0" y="26" width="330" height="124" as="geometry" /></mxCell><mxCell id="dp_align" value="DEPOSIT_ALIGN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="dp_phase"><mxGeometry x="1499" y="60" width="330" height="94" as="geometry" /></mxCell><mxCell id="dp_align_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Rotate_Angle_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.angle, centre_deg - scan_deg)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// face the Deposit marker's centre&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="dp_align"><mxGeometry x="0" y="26" width="330" height="68" as="geometry" /></mxCell><mxCell id="dp_measure" value="MEASURE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="dp_phase"><mxGeometry x="1499" y="300" width="330" height="108" as="geometry" /></mxCell><mxCell id="dp_measure_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive(STOP)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;samples = 0&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Ultrasonic_Read() once per Tick;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;after 5: reading = median&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// reading &amp;lt; 320: blind zone&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="dp_measure"><mxGeometry x="0" y="26" width="330" height="82" as="geometry" /></mxCell><mxCell id="dp_drive" value="DEPOSIT_DRIVE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="dp_phase"><mxGeometry x="900" y="300" width="330" height="110" as="geometry" /></mxCell><mxCell id="dp_drive_body" value="&lt;b&gt;entry /&lt;/b&gt; Kobuki_Drive_Distance_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.distance, drive_mm)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// drive_mm &amp;lt; 0 reverses&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive_Distance(kobuki.distance)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// cliff is ignored&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="dp_drive"><mxGeometry x="0" y="26" width="330" height="84" as="geometry" /></mxCell><mxCell id="dp_backoff" value="DEPOSIT_BACKOFF" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;swimlaneFillColor=#ffffff;" vertex="1" parent="dp_phase"><mxGeometry x="1499" y="500" width="330" height="122" as="geometry" /></mxCell><mxCell id="dp_backoff_body" value="&lt;b&gt;entry /&lt;/b&gt; backoffs = backoffs + 1&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Drive_Distance_Setpoint(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kobuki.distance, -150)&lt;br&gt;&lt;b&gt;do /&lt;/b&gt; Kobuki_Drive_Distance(kobuki.distance)&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// straight back keeps the Centre&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;&lt;i&gt;// heading; bumper, cliff ignored&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;spacingBottom=0;fontSize=11;fontFamily=Courier New;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="dp_backoff"><mxGeometry x="0" y="26" width="330" height="96" as="geometry" /></mxCell><mxCell id="dp_note" value="&lt;b&gt;Deposit phase&lt;/b&gt; (designed; not yet in Src/main.c or helper.h)&lt;br&gt;After DRIVE_IN the AMU finds the Deposit marker, turns to its Centre heading and stops DEPOSIT_GAP short of it, then returns to IDLE. There is no give-up, and no fault except B1 | wheeldrop (the red edge from the phase).&lt;br&gt;&lt;b&gt;Scan&lt;/b&gt; (DEPOSIT_SEARCH, DEPOSIT_TRACK, DEPOSIT_EDGE_SCAN): scan_deg is zeroed on entry; a reading counts when range_mm &amp;lt; 500 (not the 750 Detection range); DEPOSIT_SEARCH and DEPOSIT_TRACK turn ACW, DEPOSIT_EDGE_SCAN turns CW back across the marker, all at the same slow speed (50). The middle of the two edges is the Centre heading; DEPOSIT_ALIGN turns to it.&lt;br&gt;&lt;b&gt;Measure&lt;/b&gt;: the ultrasonic reads about 300 mm for anything nearer (blind zone), so a reading under 320 is not a distance. DEPOSIT_BACKOFF reverses 150 straight back (the Centre heading holds) and re-measures; after 5 DEPOSIT_BACKOFFs MEASURE goes to IDLE. Otherwise drive_mm = reading - SONAR_OFFSET_MM - 100, signed: DEPOSIT_DRIVE reverses when it is negative, then ends in IDLE.&lt;br&gt;&lt;b&gt;Constants (planned names):&lt;/b&gt; DEPOSIT_DETECT_MM 500, DEPOSIT_SCAN_SPEED_MM_S 50, DEPOSIT_LOST_DEG 10, DEPOSIT_EDGE_BAND_MM 60, DEPOSIT_GAP_MM 100 (AMU front to marker surface), SONAR_OFFSET_MM (to be measured: how far the sonar face sits behind the AMU front), DEPOSIT_BLIND_MM 320, DEPOSIT_BACKOFF_MM 150, DEPOSIT_BACKOFF_MAX 5." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="dp_phase"><mxGeometry x="20" y="470" width="1180" height="180" as="geometry" /></mxCell><mxCell id="dp_diamond" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1380" y="1650" width="28" height="28" as="geometry" /></mxCell><mxCell id="dp_exit" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="606" y="1660" width="14" height="14" as="geometry" /></mxCell><mxCell id="lg_jn" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1054" y="2026" width="14" height="14" as="geometry" /></mxCell><mxCell id="lg_jn_t" value="junction: edges merge into one" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontSize=11;fontFamily=Helvetica;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1076" y="2026" width="200" height="18" as="geometry" /></mxCell><mxCell id="e_turn_drivein" value="kobuki.rotation_complete" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="turn" target="drive_in"><mxGeometry relative="1" as="geometry"><mxPoint x="75.0" y="0.0" as="offset" /></mxGeometry></mxCell><mxCell id="p_drive_reverse" value="&lt;div style=&quot;text-align:left&quot;&gt;2: storage wall bumper&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[A: kobuki.bumper &amp; 0x04, B: kobuki.bumper &amp; 0x01]&lt;br&gt;3: ledge cliff&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[A: kobuki.cliff &amp; 0x01, B: kobuki.cliff &amp; 0x04]&lt;/div&gt;" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.8529;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8529;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p_drive" target="p_reverse"><mxGeometry relative="1" as="geometry"><mxPoint x="-160.0" y="0.0" as="offset" /></mxGeometry></mxCell><mxCell id="p_reverse_rotate" value="kobuki.distance_complete" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p_reverse" target="p_rotate"><mxGeometry relative="1" as="geometry"><mxPoint x="78.0" y="0.0" as="offset" /></mxGeometry></mxCell><mxCell id="p_rotate_drive" value="kobuki.&lt;br&gt;rotation_&lt;br&gt;complete" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;align=center;exitX=1.0000;exitY=0.2459;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.2985;entryDx=0;entryDy=0;entryPerimeter