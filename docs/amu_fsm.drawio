<mxfile host="app.diagrams.net" agent="hiten" version="24.7.5"><diagram id="amu_fsm" name="AMU FSM"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1770" pageHeight="1785" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s_idle" value="IDLE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="80" width="180" height="130" as="geometry"/></mxCell><mxCell id="s_idle_body" value="do / Kobuki_Drive(STOP)&lt;br&gt;exit / layout = none&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.detected = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;swept_deg = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;sweep_count = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;last_angle = kobuki.angle&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;heading = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;corridor = 0" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_idle"><mxGeometry y="26" width="180" height="104" as="geometry"/></mxCell><mxCell id="s_search" value="SEARCH" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="340" height="180" as="geometry"/></mxCell><mxCell id="s_search_body" value="do / if object.detected:&amp;nbsp;&amp;nbsp;&amp;nbsp;// range_mm is object.range_mm&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;if 500 &amp;lt; range_mm &amp;lt;= 650:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;layout = A&amp;nbsp;&amp;nbsp;&amp;nbsp;// far bollard&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;else if 300 &amp;lt;= range_mm &amp;lt;= 500:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;layout = B&amp;nbsp;&amp;nbsp;&amp;nbsp;// near bollard&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;else:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;layout = none&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;// deduced from this reading, saved&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;// (overwritten at every Detection)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_search"><mxGeometry y="26" width="340" height="154" as="geometry"/></mxCell><mxCell id="s_align" value="ALIGN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="930" y="80" width="330" height="100" as="geometry"/></mxCell><mxCell id="s_align_body" value="entry / Kobuki_Rotate_Angle_Setpoint(kobuki.angle,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+13)&amp;nbsp;&amp;nbsp;&amp;nbsp;// ACW, the way SEARCH was spinning&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// first-detection heading to centre heading&lt;br&gt;do / Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_align"><mxGeometry y="26" width="330" height="74" as="geometry"/></mxCell><mxCell id="s_orient" value="ORIENT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1420" y="80" width="310" height="120" as="geometry"/></mxCell><mxCell id="s_orient_body" value="entry / Kobuki_Rotate_Angle_Setpoint(kobuki.angle,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;A: +90, B: -90)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// A: ACW (FSM_ORIENT_A_DEG)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// B: CW (FSM_ORIENT_B_DEG)&lt;br&gt;do / Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_orient"><mxGeometry y="26" width="310" height="94" as="geometry"/></mxCell><mxCell id="s_start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="182" y="28" width="16" height="16" as="geometry"/></mxCell><mxCell id="s_detect" value="DETECT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="440" y="380" width="300" height="150" as="geometry"/></mxCell><mxCell id="s_detect_body" value="do / Kobuki_Drive(STOP)&amp;nbsp;&amp;nbsp;&amp;nbsp;// hold still&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Ultrasonic_Detect(&amp;amp;object):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.range_mm = ultrasonic reading&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if range_mm &amp;lt; 700:&amp;nbsp;&amp;nbsp;&amp;nbsp;// object closer than 700&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.detected = 1&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;else:&amp;nbsp;&amp;nbsp;&amp;nbsp;// object further, or nothing&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;object.detected = 0" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_detect"><mxGeometry y="26" width="300" height="124" as="geometry"/></mxCell><mxCell id="s_spin" value="SPIN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="930" y="380" width="310" height="190" as="geometry"/></mxCell><mxCell id="s_spin_body" value="entry / Kobuki_Rotate_Angle_Setpoint(kobuki.angle,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+15)&amp;nbsp;&amp;nbsp;&amp;nbsp;// one Step, ACW&lt;br&gt;do / Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;exit / swept_deg += shortest signed angle from&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;last_angle to kobuki.angle&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// + = ACW, wraps at +/-180&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;last_angle = kobuki.angle&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;if swept_deg &amp;gt;= 360:&amp;nbsp;&amp;nbsp;&amp;nbsp;// one full Sweep&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;swept_deg -= 360&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sweep_count++" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_spin"><mxGeometry y="26" width="310" height="164" as="geometry"/></mxCell><mxCell id="s_stop" value="STOP / FAULT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="440" y="680" width="760" height="80" as="geometry"/></mxCell><mxCell id="s_stop_body" value="do / Kobuki_Drive(STOP)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_stop"><mxGeometry y="26" width="760" height="54" as="geometry"/></mxCell><mxCell id="s_deposit" value="DEPOSIT (stub)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="100" y="880" width="260" height="90" as="geometry"/></mxCell><mxCell id="s_deposit_body" value="Stub, not yet designed.&lt;br&gt;The parcel goes to deposit location 1 or 2&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(independent of the layout)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_deposit"><mxGeometry y="26" width="260" height="64" as="geometry"/></mxCell><mxCell id="s_storage" value="STORAGE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#e6e6e6;strokeColor=#666666;swimlaneFillColor=#f6f6f6;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="440" height="400" as="geometry"/></mxCell><mxCell id="t_drive" value="DRIVE_IN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_storage"><mxGeometry x="40" y="60" width="360" height="70" as="geometry"/></mxCell><mxCell id="t_drive_body" value="entry / Kobuki_Drive_Distance_Setpoint(kobuki.distance, 1000)&lt;br&gt;do / Kobuki_Drive_Distance(kobuki.distance)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="t_drive"><mxGeometry y="26" width="360" height="44" as="geometry"/></mxCell><mxCell id="t_turn" value="TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_storage"><mxGeometry x="40" y="190" width="360" height="100" as="geometry"/></mxCell><mxCell id="t_turn_body" value="entry / Kobuki_Rotate_Angle_Setpoint(kobuki.angle,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;A: +135, B: -135)&amp;nbsp;&amp;nbsp;&amp;nbsp;// A: ACW, B: CW&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// face the entrance (diagonal opening)&lt;br&gt;do / Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="t_turn"><mxGeometry y="26" width="360" height="74" as="geometry"/></mxCell><mxCell id="s_pathfind" value="PATHFIND" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#e6e6e6;strokeColor=#666666;swimlaneFillColor=#f6f6f6;" vertex="1" parent="1"><mxGeometry x="580" y="840" width="990" height="640" as="geometry"/></mxCell><mxCell id="p_drive" value="DRIVE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_pathfind"><mxGeometry x="40" y="200" width="340" height="80" as="geometry"/></mxCell><mxCell id="p_drive_body" value="do / Kobuki_Drive(100)&amp;nbsp;&amp;nbsp;&amp;nbsp;// below the speed limit of 150" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_drive"><mxGeometry y="26" width="340" height="54" as="geometry"/></mxCell><mxCell id="p_wall" value="REVERSE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_pathfind"><mxGeometry x="640" y="60" width="310" height="90" as="geometry"/></mxCell><mxCell id="p_wall_body" value="entry / Kobuki_Drive_Distance_Setpoint(kobuki.distance, -50)&lt;br&gt;do / Kobuki_Drive_Distance(kobuki.distance)&lt;br&gt;// bumper/cliff ignored; B1 | wheeldrop -&gt; FAULT" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_wall"><mxGeometry y="26" width="310" height="64" as="geometry"/></mxCell><mxCell id="p_realign" value="ROTATE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_pathfind"><mxGeometry x="640" y="200" width="310" height="155" as="geometry"/></mxCell><mxCell id="p_realign_body" value="entry / Kobuki_Rotate_Angle_Setpoint(kobuki.angle,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;A: +10, B: -10)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// fixed nudge after Reverse&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// does not use heading&lt;br&gt;do / Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;// bumper/cliff ignored; B1 | wheeldrop -&gt; FAULT" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_realign"><mxGeometry y="26" width="310" height="129" as="geometry"/></mxCell><mxCell id="p_fct" value="CORRIDOR_TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_pathfind"><mxGeometry x="220" y="360" width="320" height="100" as="geometry"/></mxCell><mxCell id="p_fct_body" value="entry / Kobuki_Rotate_Angle_Setpoint(kobuki.angle,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;A: +90, B: -90)&amp;nbsp;&amp;nbsp;&amp;nbsp;// A: ACW, B: CW&lt;br&gt;do / Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;exit / heading = kobuki.angle&amp;nbsp;&amp;nbsp;&amp;nbsp;// re-latch the heading" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_fct"><mxGeometry y="26" width="320" height="74" as="geometry"/></mxCell><mxCell id="p_fcs" value="CORRIDOR_STOP" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_pathfind"><mxGeometry x="30" y="450" width="180" height="60" as="geometry"/></mxCell><mxCell id="p_fcs_body" value="entry / Kobuki_Drive(STOP)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_fcs"><mxGeometry y="26" width="180" height="34" as="geometry"/></mxCell><mxCell id="p_choice" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="687" y="1207" width="26" height="26" as="geometry"/></mxCell><mxCell id="p_foot" value="One shared sub-FSM, run twice: corridor = 1 (first corridor), then corridor = 2. A / B is the saved layout (A: storage wall on the right, ledge on the left. B: the mirror image).&lt;br&gt;CORRIDOR_TURN (corridor 1) and CORRIDOR_STOP (corridor 2) are the two outcomes of reaching corridor length; the diamond picks one by its guard.&lt;br&gt;One red edge for the whole region: B1 | wheeldrop -&amp;gt; STOP / FAULT. There are no other faults in PATHFIND.&lt;br&gt;DRIVE triggers are checked in the order 1, 2, 3. Ignored in DRIVE: bumper on the ledge side, cliff on the storage wall side, centre bumper.&lt;br&gt;Wall bumper and ledge cliff both enter REVERSE then ROTATE then DRIVE (no +50 mm forward resume). No reverse after corridor length. Centre cliff ignored in Drive." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fontColor=#555555;spacingLeft=10;spacingRight=10;spacingTop=4;" vertex="1" parent="s_pathfind"><mxGeometry x="40" y="540" width="920" height="90" as="geometry"/></mxCell><mxCell id="t_foot" value="Entered from PATHFIND (corridor 2), stopped after corridor length.&lt;br&gt;One red edge for the whole region: B1 | wheeldrop -&amp;gt; STOP / FAULT. There are no other faults in STORAGE.&lt;br&gt;Ignored in TURN: kobuki.bumper and kobuki.cliff (the turn is made beside the ledge). Ignored in DRIVE_IN: kobuki.cliff." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fontColor=#555555;spacingLeft=10;spacingRight=10;spacingTop=4;" vertex="1" parent="s_storage"><mxGeometry x="20" y="320" width="400" height="80" as="geometry"/></mxCell><mxCell id="lg_dot" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="44" y="1504" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_dot_t" value="start (initial state)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;spacingLeft=0;spacingRight=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="66" y="1503" width="120" height="18" as="geometry"/></mxCell><mxCell id="lg_dia" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="217" y="1499" width="26" height="26" as="geometry"/></mxCell><mxCell id="lg_dia_t" value="choice: one trigger, the guard on each edge picks the way" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fontColor=#333333;spacingLeft=0;spacingRight=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="248" y="1503" width="340" height="18" as="geometry"/></mxCell><mxCell id="lg_st" value="state" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="600" y="1500" width="70" height="24" as="geometry"/></mxCell><mxCell id="lg_fa" value="fault" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="690" y="1500" width="70" height="24" as="geometry"/></mxCell><mxCell id="lg_re" value="composite state (sub-FSM)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#f6f6f6;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="780" y="1500" width="160" height="24" as="geometry"/></mxCell><mxCell id="lg_su" value="stub" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="1500" width="70" height="24" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Conventions (UML state machine notation)&lt;/b&gt;&lt;br&gt;A state is a rounded box: its name, then its actions only. entry / runs once on entering the state, do / on every loop step, exit / once on leaving it. Every trigger and [guard] is on an edge, written: trigger [guard] / effect.&lt;br&gt;ε means no trigger: the edge is taken at the next loop step, so each state still takes one Kobuki packet. Composite states (PATHFIND, STORAGE) write their sub-states as REGION.STATE, e.g. PATHFIND.DRIVE.&lt;br&gt;A / B in a box or on an edge is the layout saved by SEARCH, never a live reading. Layout A: bollards A1/A2 block the left/top route, so the AMU takes the bottom corridor, then the right corridor. Layout B: bollards B1/B2 block the bottom/right route, so the AMU takes the left corridor, then the top corridor. Layout A has the storage wall on the right and the ledge on the left. Layout B is the mirror image.&lt;br&gt;Angles are in degrees: + = ACW (left), - = CW (right)&amp;nbsp;&amp;nbsp;&amp;nbsp;(Kobuki_Rotate: +ve is CCW). heading is the corridor heading: it is re-latched at the start of each corridor.&lt;br&gt;Bumper / cliff bits (Kobuki protocol): right = 0x01, centre = 0x02, left = 0x04. B0 = kobuki.button &amp;amp; 0x01 (start). B1 = kobuki.button &amp;amp; 0x02 (stop). wheeldrop = kobuki.wheeldrop != 0.&lt;br&gt;B1 and wheeldrop have a red edge to STOP / FAULT from every state except IDLE (PATHFIND and STORAGE have one edge each, for all their sub-states). Bumper and cliff are expected in PATHFIND and STORAGE, so they are not faults there. kobuki.cliff is ignored in ALIGN. There are no timeouts.&lt;br&gt;One FSM step per received Kobuki packet. Sensors are read at the top of the loop (Kobuki_Read). Motion setpoints (Kobuki_Rotate_Angle_Setpoint, Kobuki_Drive_Distance_Setpoint) are one-shot entry actions. Completion flags (kobuki.rotation_complete, kobuki.distance_complete) are a snapshot from the top of the loop, so they are tested from the next loop. Drive and rotate commands are never issued in the same loop.&lt;br&gt;IDLE resets the SEARCH variables on exit, because DETECT and SPIN re-enter SEARCH and it cannot reset itself.&lt;br&gt;Tunable constants (match fsm_states.h): path speed 100, reverse 50 mm, layout ranges 300 / 500 / 650, Align +13, Spin step +15, entry distance 1000, Pathfind Rotate A +10 / B -10.&lt;br&gt;ALIGN offset (TBD): take at least 8 random start headings per layout, run SEARCH to its stop, jog to the bollard centre, record the turn. Median = the offset. Spread = the accuracy ALIGN will have. Layout medians differ by more than the spread -&amp;gt; one offset per layout. Spread too big -&amp;gt; sweep ACW to the far edge, turn back half the span.&lt;br&gt;Helpers (Src/Helper/helper.h): Layout_From_Range() holds the logic SEARCH writes out. Angle_Delta_Deg() holds the shortest-signed-angle logic of SPIN (Rotate uses a fixed layout nudge, not Angle_Delta_Deg)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fontColor=#555555;spacingLeft=0;spacingRight=0;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="1545" width="1690" height="200" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_start" target="s_idle"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e1" value="B0&lt;br&gt;[kobuki.button &amp;amp; 0x01]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.2308;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.1667;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_idle" target="s_search"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="0" y="-21" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="ε&lt;br&gt;[object.detected,&lt;br&gt;layout == A or B]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.1667;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_search" target="s_align"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="0" y="-28" as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.3000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2500;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_align" target="s_orient"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e4" value="kobuki.rotation_complete&lt;br&gt;/ heading = kobuki.angle, corridor = 1,&lt;br&gt;  corridor_start_distance = kobuki.distance" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5806;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5294;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_orient" target="p_drive"><mxGeometry relative="1" x="0" as="geometry"><Array as="points"><mxPoint x="1600" y="805"/><mxPoint x="800" y="805"/></Array><mxPoint x="-185" y="-18" as="offset"/></mxGeometry></mxCell><mxCell id="e8" value="deposit complete (stub: at once)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0769;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.1111;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_deposit" target="s_idle"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="0" y="15" as="offset"/></mxGeometry></mxCell><mxCell id="e17" value="ε&lt;br&gt;[object.detected == 0,&lt;br&gt;sweep_count &amp;lt; 2]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1176;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.1333;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_search" target="s_detect"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="78" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e18" value="ε&lt;br&gt;[object.detected]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5667;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_detect" target="s_search"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="55" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e19" value="ε&lt;br&gt;[object.detected == 0]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.4667;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3684;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_detect" target="s_spin"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="e20" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0968;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.8824;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_spin" target="s_search"><mxGeometry relative="1" x="0" as="geometry"><Array as="points"><mxPoint x="960" y="330"/><mxPoint x="740" y="330"/></Array><mxPoint x="10" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="e7" value="kobuki.distance_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.2222;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.2308;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_drive" target="s_deposit"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="e7b" value="any kobuki.bumper bit&lt;br&gt;/ Kobuki_Drive(STOP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.6667;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.8462;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_drive" target="s_deposit"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="t2" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_turn" target="t_drive"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p2" value="2: storage wall bumper&lt;br&gt;[A: kobuki.bumper &amp;amp; 0x01&lt;br&gt;B: kobuki.bumper &amp;amp; 0x04]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.9000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3500;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_drive" target="p_wall"><mxGeometry relative="1" x="0" as="geometry"><Array as="points"><mxPoint x="926" y="930"/></Array><mxPoint x="48" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="p3" value="3: ledge cliff&lt;br&gt;[A: kobuki.cliff &amp;amp; 0x04&lt;br&gt;B: kobuki.cliff &amp;amp; 0x01]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_drive" target="p_wall"><mxGeometry relative="1" x="0" as="geometry"><Array as="points"><mxPoint x="1100" y="1015"/></Array><mxPoint x="30" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="p4" value="kobuki.distance_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_wall" target="p_realign"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="73" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p6" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_realign" target="p_drive"><mxGeometry relative="1" x="0" as="geometry"><Array as="points"><mxPoint x="1090" y="1118"/><mxPoint x="1090" y="1080"/></Array><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="p7" value="1: corridor length&lt;br&gt;[delta mm &amp;gt;= 1200]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.2353;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_drive" target="p_choice"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="86" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p9" value="[corridor == 1]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_choice" target="p_fct"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="0" y="-13" as="offset"/></mxGeometry></mxCell><mxCell id="p8" value="[corridor == 2]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_choice" target="p_fcs"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="57" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="kobuki.rotation_complete&lt;br&gt;/ corridor = 2,&lt;br&gt;  corridor_start_distance = kobuki.distance" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.4062;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.9118;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_fct" target="p_drive"><mxGeometry relative="1" x="0" as="geometry"><mxPoint x="112" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e6" value="ε" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_fcs"