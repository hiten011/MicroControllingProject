<mxfile host="app.diagrams.net" agent="hiten" version="24.7.5"><diagram id="amu_fsm" name="AMU FSM"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s_idle" value="IDLE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="470" height="284" as="geometry"/></mxCell><mxCell id="s_idle_body" value="Kobuki_Drive(STOP)                  // every loop&lt;br&gt;Wait for B0:&lt;br&gt;&amp;nbsp;&amp;nbsp;kobuki.button &amp;amp; BUTTON_0_START" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_idle"><mxGeometry y="26" width="470" height="258" as="geometry"/></mxCell><mxCell id="s_search" value="SEARCH" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="660" y="40" width="470" height="284" as="geometry"/></mxCell><mxCell id="s_search_body" value="Entry: layout = none, swept_deg = 0, sweep_count = 0,&lt;br&gt;&amp;nbsp;&amp;nbsp;last_angle = kobuki.angle&lt;br&gt;Every loop:&lt;br&gt;&amp;nbsp;&amp;nbsp;Ultrasonic_Detect(&amp;amp;object)&lt;br&gt;&amp;nbsp;&amp;nbsp;object.detected (range &amp;lt; ULTRASONIC_DETECT_RANGE_MM):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Drive(STOP)                 // stop immediately&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;layout = AMU_Layout_From_Range(object.range_mm)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// deduced from this sample, saved (overwritten at every stop)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;layout none -&amp;gt; STOP / FAULT, otherwise -&amp;gt; ALIGN&lt;br&gt;&amp;nbsp;&amp;nbsp;nothing detected:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;swept_deg += AMU_Angle_Delta_Deg(last_angle, kobuki.angle)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;last_angle = kobuki.angle&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;360 deg swept -&amp;gt; sweep_count++&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sweep_count == MAX_SEARCH_SWEEPS -&amp;gt; STOP / FAULT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Kobuki_Rotate(SEARCH_SPEED)        // spin on the spot, ACW&lt;br&gt;Any kobuki.bumper or kobuki.cliff bit -&amp;gt; STOP / FAULT" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_search"><mxGeometry y="26" width="470" height="258" as="geometry"/></mxCell><mxCell id="s_align" value="ALIGN (stub)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1280" y="40" width="470" height="284" as="geometry"/></mxCell><mxCell id="s_orient" value="ORIENT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1900" y="40" width="470" height="284" as="geometry"/></mxCell><mxCell id="s_orient_body" value="Layout saved by SEARCH (no live range):&lt;br&gt;&amp;nbsp;&amp;nbsp;A: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -90)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// CW 90: now facing the bottom corridor&lt;br&gt;&amp;nbsp;&amp;nbsp;B: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +90)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// ACW 90: now facing the left corridor&lt;br&gt;Setpoint once on entry. Each loop: Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;Any kobuki.bumper or kobuki.cliff bit -&amp;gt; STOP / FAULT" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_orient"><mxGeometry y="26" width="470" height="258" as="geometry"/></mxCell><mxCell id="s_stop" value="STOP / FAULT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="925" y="404" width="560" height="209" as="geometry"/></mxCell><mxCell id="s_stop_body" value="Kobuki_Drive(STOP), then return to IDLE&lt;br&gt;Entered from every non-idle state on:&lt;br&gt;&amp;nbsp;&amp;nbsp;kobuki.button &amp;amp; BUTTON_1_STOP (B1)&lt;br&gt;&amp;nbsp;&amp;nbsp;kobuki.wheeldrop != 0&lt;br&gt;&amp;nbsp;&amp;nbsp;any fault:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;nothing found after MAX_SEARCH_SWEEPS sweeps&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;layout none at the SEARCH stop&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;any kobuki.bumper bit in SEARCH, ALIGN, ORIENT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;any kobuki.cliff bit in SEARCH, ORIENT&lt;br&gt;No other faults: bumper and cliff are expected in PATHFIND&lt;br&gt;and STORAGE, and there are no timeouts." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_stop"><mxGeometry y="26" width="560" height="183" as="geometry"/></mxCell><mxCell id="s_deposit" value="DEPOSIT (stub)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="441" width="470" height="140" as="geometry"/></mxCell><mxCell id="e1" value="B0&lt;br&gt;BUTTON_0_START" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.2000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_idle" target="s_search"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="layout A or B" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.2000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_search" target="s_align"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="align done (stub: at once)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.2000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_align" target="s_orient"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="e8" value="deposit complete (stub: at once)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1500;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.1500;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_deposit" target="s_idle"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="62" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e9" value="B1 | wheeldrop | fault" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.8500;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.2402;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_search" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="-66" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e10" value="B1 | wheeldrop | bumper" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1500;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.7598;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_align" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="66" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e13" value="B1 | wheeldrop | bumper | cliff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1200;exitY=1.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_orient" target="s_stop"><mxGeometry relative="1" x="0.55" as="geometry"><Array as="points"><mxPoint x="1956" y="467"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e15" value="B1 | wheeldrop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.8500;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.7464;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_deposit" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e16" value="return to IDLE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.2000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.8000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_stop" target="s_idle"><mxGeometry relative="1" x="-0.35" as="geometry"><Array as="points"><mxPoint x="585" y="446"/><mxPoint x="585" y="267"/></Array><mxPoint x="0" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="note" value="Conventions&lt;br&gt;Angles are in degrees: + = ACW (left), - = CW (right)  (Kobuki_Rotate: +ve is CCW).&lt;br&gt;Layout A: bollards A1/A2 block the left/top route, so the AMU takes the bottom corridor, then the right corridor.&lt;br&gt;Layout B: bollards B1/B2 block the bottom/right route, so the AMU takes the left corridor, then the top corridor.&lt;br&gt;Layout A has the storage wall on the left and the ledge on the right. Layout B is the mirror image.&lt;br&gt;Sub-states are written REGION.STATE (PATHFIND.DRIVE, STORAGE.TURN). Every sub-state: B1 or wheel drop -&gt; STOP / FAULT (one edge per region). There are no other faults in PATHFIND or STORAGE.&lt;br&gt;PATHFIND is one shared sub-FSM, run twice: corridor = 1 (first corridor), then corridor = 2. heading is re-latched at the start of each corridor.&lt;br&gt;Bumper / cliff bits (Kobuki protocol): right = 0x01, centre = 0x02, left = 0x04.&lt;br&gt;One FSM step per received Kobuki packet. Sensors are read at the top of the loop (Kobuki_Read).&lt;br&gt;Motion setpoints (Kobuki_Rotate_Angle_Setpoint, Kobuki_Drive_Distance_Setpoint) are one-shot entry actions.&lt;br&gt;Completion flags (kobuki.rotation_complete, kobuki.distance_complete) are a snapshot from the top of the loop, so they are tested from the next loop.&lt;br&gt;Drive and rotate commands are never issued in the same loop.&lt;br&gt;New names (Src/AMU/amu_config.h, amu_helpers.h): BUTTON_0_START, BUTTON_1_STOP, BUMPER_RIGHT, BUMPER_CENTRE, BUMPER_LEFT, CLIFF_RIGHT, CLIFF_CENTRE, CLIFF_LEFT,&lt;br&gt;&amp;nbsp;&amp;nbsp;PATH_SPEED, WALL_DEG, LEDGE_DEG, LAYOUT_MIN_RANGE_MM, LAYOUT_RANGE_MM, LAYOUT_MAX_RANGE_MM, ENTRY_MM, MAX_SEARCH_SWEEPS, AMU_Angle_Delta_Deg(), AMU_Layout_From_Range().&lt;br&gt;&amp;nbsp;&amp;nbsp;Values not yet measured on the hardware are placeholders (marked in amu_config.h)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1658" width="2300" height="237" as="geometry"/></mxCell><mxCell id="s_deposit_body" value="Package delivered into the storage unit (stub).&lt;br&gt;Deposit location 1 or 2: not yet designed&lt;br&gt;&amp;nbsp;&amp;nbsp;(independent of the layout)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="s_deposit"><mxGeometry x="0" y="26" width="470" height="114" as="geometry"/></mxCell><mxCell id="s_pathfind" value="PATHFIND" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;fillColor=#e6e6e6;strokeColor=#666666;swimlaneFillColor=#f6f6f6;" vertex="1" parent="1"><mxGeometry x="890" y="693" width="1480" height="915" as="geometry"/></mxCell><mxCell id="p_drive" value="DRIVE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_pathfind"><mxGeometry x="80" y="86" width="560" height="224" as="geometry"/></mxCell><mxCell id="p_drive_body" value="Kobuki_Drive(PATH_SPEED)       // every loop, below SPEED_LIMIT&lt;br&gt;Triggers, checked in this order:&lt;br&gt;&amp;nbsp;&amp;nbsp;1. front cliff:   kobuki.cliff &amp;amp; CLIFF_CENTRE&lt;br&gt;&amp;nbsp;&amp;nbsp;2. storage wall bumper:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;A: kobuki.bumper &amp;amp; BUMPER_LEFT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;B: kobuki.bumper &amp;amp; BUMPER_RIGHT&lt;br&gt;&amp;nbsp;&amp;nbsp;3. ledge cliff:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;A: kobuki.cliff &amp;amp; CLIFF_RIGHT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;B: kobuki.cliff &amp;amp; CLIFF_LEFT&lt;br&gt;Ignored: bumper on the ledge side, cliff on the storage&lt;br&gt;&amp;nbsp;&amp;nbsp;wall side, BUMPER_CENTRE&lt;br&gt;Drive and rotate commands are never issued in the same loop" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_drive"><mxGeometry x="0" y="26" width="560" height="198" as="geometry"/></mxCell><mxCell id="p_wall" value="WALL_HIT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_pathfind"><mxGeometry x="820" y="56" width="580" height="104" as="geometry"/></mxCell><mxCell id="p_wall_body" value="Entry (one-shot): turn away from the storage wall&lt;br&gt;&amp;nbsp;&amp;nbsp;A: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -WALL_DEG)   // CW&lt;br&gt;&amp;nbsp;&amp;nbsp;B: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +WALL_DEG)   // ACW&lt;br&gt;Each loop: Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_wall"><mxGeometry x="0" y="26" width="580" height="78" as="geometry"/></mxCell><mxCell id="p_ledge" value="LEDGE_HIT" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_pathfind"><mxGeometry x="820" y="396" width="580" height="104" as="geometry"/></mxCell><mxCell id="p_ledge_body" value="Entry (one-shot): turn away from the ledge&lt;br&gt;&amp;nbsp;&amp;nbsp;A: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +LEDGE_DEG)  // ACW&lt;br&gt;&amp;nbsp;&amp;nbsp;B: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -LEDGE_DEG)  // CW&lt;br&gt;Each loop: Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_ledge"><mxGeometry x="0" y="26" width="580" height="78" as="geometry"/></mxCell><mxCell id="p_realign" value="REALIGN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_pathfind"><mxGeometry x="820" y="736" width="580" height="119" as="geometry"/></mxCell><mxCell id="p_realign_body" value="Entry (one-shot): back to the corridor heading&lt;br&gt;&amp;nbsp;&amp;nbsp;Kobuki_Rotate_Angle_Setpoint(kobuki.angle,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;AMU_Angle_Delta_Deg(kobuki.angle, heading))&lt;br&gt;&amp;nbsp;&amp;nbsp;// shortest signed rotation to the latched heading&lt;br&gt;Each loop: Kobuki_Rotate_Angle(kobuki.angle)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_realign"><mxGeometry x="0" y="26" width="580" height="93" as="geometry"/></mxCell><mxCell id="p_fct" value="FRONT_CLIFF_TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_pathfind"><mxGeometry x="80" y="456" width="560" height="194" as="geometry"/></mxCell><mxCell id="p_fct_body" value="corridor == 1 (first corridor):&lt;br&gt;&amp;nbsp;&amp;nbsp;Entry (one-shot):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;A: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +90)   // ACW&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;B: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -90)   // CW&lt;br&gt;&amp;nbsp;&amp;nbsp;Each loop: Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;&amp;nbsp;&amp;nbsp;kobuki.rotation_complete: heading = kobuki.angle (re-latch),&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;corridor = 2, back to DRIVE&lt;br&gt;corridor == 2 (second corridor):&lt;br&gt;&amp;nbsp;&amp;nbsp;Kobuki_Drive(STOP), exit to STORAGE.TURN&lt;br&gt;No reverse (back-off) here: a hardware experiment only" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="p_fct"><mxGeometry x="0" y="26" width="560" height="168" as="geometry"/></mxCell><mxCell id="p_foot" value="Drives the first, then the second corridor (corridor counter 1, then 2). One shared sub-FSM, parameterised by the layout (A: storage wall on the left, ledge on the right. B: the mirror image)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=10;spacingRight=6;fontSize=11;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="s_pathfind"><mxGeometry x="0" y="875" width="1480" height="30" as="geometry"/></mxCell><mxCell id="s_storage" value="STORAGE" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=13;fontFamily=Helvetica;fillColor=#e6e6e6;strokeColor=#666666;swimlaneFillColor=#f6f6f6;" vertex="1" parent="1"><mxGeometry x="40" y="693" width="640" height="478" as="geometry"/></mxCell><mxCell id="t_drive" value="DRIVE_IN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_storage"><mxGeometry x="40" y="50" width="560" height="134" as="geometry"/></mxCell><mxCell id="t_drive_body" value="Entry (one-shot):&lt;br&gt;&amp;nbsp;&amp;nbsp;Kobuki_Drive_Distance_Setpoint(kobuki.distance, ENTRY_MM)&lt;br&gt;Each loop: Kobuki_Drive_Distance(kobuki.distance)&lt;br&gt;Any kobuki.bumper bit: Kobuki_Drive(STOP)&lt;br&gt;kobuki.cliff is ignored" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="t_drive"><mxGeometry x="0" y="26" width="560" height="108" as="geometry"/></mxCell><mxCell id="t_turn" value="TURN" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=26;horizontal=1;html=1;whiteSpace=wrap;collapsible=0;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" vertex="1" parent="s_storage"><mxGeometry x="40" y="284" width="560" height="134" as="geometry"/></mxCell><mxCell id="t_turn_body" value="Entry (one-shot): face the entrance (diagonal opening)&lt;br&gt;&amp;nbsp;&amp;nbsp;A: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, +135)   // ACW&lt;br&gt;&amp;nbsp;&amp;nbsp;B: Kobuki_Rotate_Angle_Setpoint(kobuki.angle, -135)   // CW&lt;br&gt;Each loop: Kobuki_Rotate_Angle(kobuki.angle)&lt;br&gt;kobuki.bumper and kobuki.cliff are ignored (the turn is&lt;br&gt;&amp;nbsp;&amp;nbsp;made beside the ledge)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;fontFamily=Helvetica;overflow=hidden;" vertex="1" parent="t_turn"><mxGeometry x="0" y="26" width="560" height="108" as="geometry"/></mxCell><mxCell id="t_foot" value="Faces the entrance (A: turn +135, B: turn -135), then drives into the storage unit." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=10;spacingRight=6;fontSize=11;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="s_storage"><mxGeometry x="0" y="448" width="640" height="28" as="geometry"/></mxCell><mxCell id="e4" value="kobuki.rotation_complete&lt;br&gt;(corridor = 1, heading = kobuki.angle)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_orient" target="p_drive"><mxGeometry relative="1" x="0.0" as="geometry"><Array as="points"><mxPoint x="2135" y="670"/><mxPoint x="1250" y="670"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p2" value="storage wall bumper&lt;br&gt;(2nd trigger)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.1200;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3500;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_drive" target="p_wall"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="p3" value="ledge cliff&lt;br&gt;(3rd trigger)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.7500;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3500;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_drive" target="p_ledge"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="p4" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_wall" target="p_realign"><mxGeometry relative="1" x="0.2" as="geometry"><Array as="points"><mxPoint x="2350" y="801"/><mxPoint x="2350" y="1464.7"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p5" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_ledge" target="p_realign"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="70" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p6" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.2000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.9200;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_realign" target="p_drive"><mxGeometry relative="1" x="0.1" as="geometry"><Array as="points"><mxPoint x="1590" y="1452.8"/><mxPoint x="1590" y="985.08"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p7" value="front cliff (1st trigger)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_drive" target="p_fct"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="70" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="corridor 1: kobuki.rotation_complete&lt;br&gt;(heading re-latched, corridor = 2)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.3000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_fct" target="p_drive"><mxGeometry relative="1" x="0.0" as="geometry"><Array as="points"><mxPoint x="930" y="1207.2"/><mxPoint x="930" y="891"/></Array><mxPoint x="120" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e6" value="corridor 2:&lt;br&gt;stopped at the front cliff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.7500;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_fct" target="t_turn"><mxGeometry relative="1" x="0.0" as="geometry"><Array as="points"><mxPoint x="785" y="1294.5"/><mxPoint x="785" y="1017.2"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="t2" value="kobuki.rotation_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_turn" target="t_drive"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e7" value="kobuki.distance_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.2143;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.3404;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_drive" target="s_deposit"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e7b" value="any kobuki.bumper bit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.7143;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.9362;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_drive" target="s_deposit"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e11" value="B1 | wheeldrop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.8500;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.2402;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_storage" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><Array as="points"><mxPoint x="584" y="653"/><mxPoint x="1059.51" y="653"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e12" value="B1 | wheeldrop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.1824;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.4196;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pathfind" target="s_stop"><mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="-50" y="0" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>